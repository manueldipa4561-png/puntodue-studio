---
import '@fontsource-variable/inter-tight';
import Chat from '../components/Chat.astro';
import { siFigma, siClaude, siClaudecode, siDeepseek, siElevenlabs, siAstro, siThreedotjs, siGreensock, siGithub, siCaldotcom, siNetlify, siShopify } from 'simple-icons';
// Numero WhatsApp senza + (preso da puntoduestudio.it). Vuoto = il pulsante ripiega sull'email.
const WA_NUMBER = '393248423657';
const WA_TEXT = 'Ciao! Vorrei parlarvi di un progetto. Quando potremmo sentirci?';
const contactHref = WA_NUMBER ? `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_TEXT)}` : 'mailto:projects@puntoduestudio.it?subject=Nuovo%20progetto';
const contactExternal = Boolean(WA_NUMBER);
const tools = [siFigma, siClaude, siClaudecode, siDeepseek, { title: 'Higgsfield', path: '', img: '/higgsfield.png' }, siElevenlabs, siAstro, siThreedotjs, siGreensock, siGithub, siCaldotcom, siNetlify, siShopify];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0034D6" />
    <title>Punto Due Studio — Web.2</title>
    <meta name="description" content="Punto Due Studio: siti web, e-commerce, app, gestione social e agenti AI per attività di ogni settore." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content="Punto Due Studio — Web.2" />
    <meta property="og:description" content="Siti, app, social e agenti AI per la tua attività." />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="hdr">
      <a class="brand" href="/" aria-label="Punto Due Studio">
        <svg id="mark" class="mark pre" viewBox="0 0 100 100" aria-hidden="true">
          <defs><clipPath id="lensClip"><circle cx="37" cy="50" r="27" /></clipPath></defs>
          <circle cx="37" cy="50" r="27" fill="#fff" />
          <circle cx="63" cy="50" r="27" fill="#FFE000" />
          <circle cx="63" cy="50" r="27" fill="#0034D6" clip-path="url(#lensClip)" />
        </svg>
        <span class="word pre"><span class="name">Punto Due</span><span class="sub">STUDIO</span></span>
      </a>
      <nav class="nav pre" aria-label="Principale">
        <a href="#web">/web</a>
        <a href="#social">/social</a>
        <a href="#info">/info</a>
      </nav>
      <span class="prog" aria-hidden="true"></span>
    </header>

    <canvas id="bg" aria-hidden="true"></canvas>

    <main>
      <section class="hero" id="top">
        <h1 class="big pre" aria-label="Web.2"><span class="ch" aria-hidden="true"><span class="chi">W</span></span><span class="ch" aria-hidden="true"><span class="chi">e</span></span><span class="ch" aria-hidden="true"><span class="chi">b</span></span><span class="ch dot" aria-hidden="true"><span class="chi">.</span></span><span class="ch" aria-hidden="true"><span class="chi">2</span></span></h1>
      </section>

      <div class="stack">
        <span class="lab stack-lab">/stack</span>
        <div class="band" aria-hidden="true">
          <div class="track">
            {[0, 1].map(() => tools.map((t) => <span class="chip">{t.path ? <svg viewBox="0 0 24 24" set:html={`<path d="${t.path}"/>`} /> : <img src={t.img} alt="" width="22" height="22" />}{t.title}</span>))}
          </div>
        </div>
      </div>

      <section class="sec" id="web">
        <div class="txt">
          <span class="lab rv">/web</span>
          <h2 data-split>Aggiungi alla home.</h2>
          <p class="lead rv">Un click per entrare, un tocco per restare: siti e app veloci, fatti per convertire.</p>
          <ul class="pts rv">
            <li><span>E-commerce</span><b>01</b></li>
            <li><span>App web e mobile</span><b>02</b></li>
            <li><span>SEO e prestazioni</span><b>03</b></li>
          </ul>
          <div class="cta rv"><a class="btn" href="/web">Vedi i lavori <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <section class="sec" id="social">
        <div class="txt">
          <span class="lab rv">/social</span>
          <h2 data-split>Follow Me.</h2>
          <p class="lead rv">Ti seguono, ti ricordano, ti scelgono. Strategia, contenuti e gestione dei tuoi profili.</p>
          <ul class="pts rv">
            <li><span>Strategia editoriale</span><b>01</b></li>
            <li><span>Reel, foto e grafiche nel tuo stile</span><b>02</b></li>
            <li><span>Community e crescita costante</span><b>03</b></li>
          </ul>
          <div class="cta rv"><a class="btn" href="/social">Vedi il feed <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <section class="sec" id="ai">
        <div class="txt">
          <span class="lab rv">/agents</span>
          <h2 data-split>Tre x Uno.</h2>
          <p class="lead rv">Un assistente risponde, un'automazione lavora, un report ti aggiorna: tre agenti per un solo lavoro, il tuo.</p>
          <ul class="pts rv">
            <li><span>Un assistente per i clienti</span><b>01</b></li>
            <li><span>Automazioni che collegano i tuoi strumenti</span><b>02</b></li>
            <li><span>Report chiari, senza doverli chiedere</span><b>03</b></li>
          </ul>
        </div>
      </section>

      <section class="sec info" id="info">
        <div class="txt">
          <span class="lab rv">/info</span>
          <div class="chatrow"><Chat kind="client" /></div>
          <h2 class="mega" data-split>Sta scrivendo...</h2>
          <p class="lead rv">Dall'altra parte ci siamo noi. Raccontaci il progetto.</p>
          <div class="cta rv">
            <a class="btn" href="/info">Scrivici <span class="arr" aria-hidden="true">→</span></a>
            <a class="lnk" href="mailto:projects@puntoduestudio.it">projects@puntoduestudio.it</a>
          </div>
        </div>
        <footer class="ftr">
          <span>© 2026 Punto Due Studio</span>
          <nav class="ftr-links" aria-label="Collegamenti">
            <a href="https://www.instagram.com/puntoduestudio/" target="_blank" rel="noopener">Instagram</a>
            <a href="mailto:studio@puntoduestudio.it">studio@puntoduestudio.it</a>
            <a href="/privacy">Privacy</a>
            <a href="/privacy#cookie">Cookie</a>
          </nav>
        </footer>
      </section>
    </main>

    <style is:global>
      :root { --blue: #0034d6; --yellow: #ffe000; --white: #fff; --mono: ui-monospace, 'SF Mono', Consolas, Menlo, monospace; }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--blue); color: var(--white); }
      body { font-family: 'Inter Tight Variable', system-ui, sans-serif; min-height: 100dvh; overflow-x: hidden; }
      .js .pre { visibility: hidden; }

      .hdr { position: fixed; inset: 0 0 auto 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 20px clamp(16px, 3vw, 40px); }
      .brand { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; }
      .mark { width: 44px; height: 44px; display: block; }
      .word { display: flex; flex-direction: column; line-height: 1; }
      .name { font-weight: 700; font-size: 20px; letter-spacing: -0.02em; }
      .sub { font-weight: 700; font-size: 5.2px; letter-spacing: 0.32em; margin-top: 3px; }
      .nav { display: flex; align-items: center; gap: clamp(16px, 3vw, 36px); font-weight: 600; font-size: 16px; letter-spacing: -0.01em; }
      .nav a { color: inherit; text-decoration: none; transition: color 0.2s; }
      .nav a:hover, .nav a.on { color: var(--yellow); }
      .nav a { position: relative; }
      .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(.2, .7, .2, 1); }
      .nav a.on::after { transform: scaleX(1); }
      .prog { position: absolute; left: 0; bottom: 30px; height: 1px; width: 100%; background: var(--yellow); transform: scaleX(0); transform-origin: left; opacity: 0.8; }

      .hero { min-height: 100dvh; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 clamp(16px, 3vw, 40px) clamp(12px, 3vw, 32px); }
      .big { margin: 0; font-weight: 700; font-size: clamp(6rem, 27vw, 24rem); line-height: 0.78; letter-spacing: -0.06em; }
      .big .dot { color: var(--yellow); }
      .ch { display: inline-block; clip-path: inset(-0.1em -0.1em 0 -0.1em); }
      .chi { display: inline-block; will-change: transform; }

      :root { --gut: clamp(16px, 3vw, 40px); }
      :focus-visible { outline: 2px solid var(--yellow); outline-offset: 4px; }
      html.lenis, html.lenis body { height: auto; }
      .lenis.lenis-smooth { scroll-behavior: auto !important; }
      .hdr { background: linear-gradient(var(--blue) 64%, rgba(0, 52, 214, 0)); padding-bottom: 36px; }
      #bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
      main { position: relative; z-index: 1; }
      .hero { position: relative; }

      .stack { padding: 44px 0 40px; border-block: 1px solid rgba(255, 255, 255, 0.25); }
      .stack .stack-lab { margin: 0 var(--gut) 26px; color: #fff; font: 700 clamp(1.6rem, 3vw, 2.4rem)/1 'Inter Tight Variable', system-ui, sans-serif; letter-spacing: -0.04em; text-transform: none; }
      .band { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
      .track { display: flex; width: max-content; animation: marq 45s linear infinite; }
      .band:hover .track { animation-play-state: paused; }
      .chip { display: inline-flex; align-items: center; gap: 12px; margin-right: 14px; padding: 14px 24px 14px 18px; border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 999px; font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; white-space: nowrap; transition: border-color 0.25s, color 0.25s, background 0.25s; }
      .chip svg { width: 22px; height: 22px; fill: currentColor; flex: none; }
      .chip img { width: 22px; height: 22px; border-radius: 6px; flex: none; }
      .chip .dot { width: 9px; height: 9px; margin: 0 6.5px; border-radius: 50%; background: var(--yellow); flex: none; }
      .chip:hover .dot { background: var(--blue); }
      .chip:hover { color: var(--blue); background: var(--yellow); border-color: var(--yellow); }
      @keyframes marq { to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) { .track { animation: none; } }

      .sec { position: relative; min-height: 100dvh; display: flex; align-items: flex-end; padding: 0 var(--gut) clamp(40px, 9vh, 96px); }
      .txt { max-width: 34rem; }
      .lab { font: 500 12px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--yellow); display: inline-block; }
      h2 { margin: 18px 0 20px; font-weight: 700; font-size: clamp(2.7rem, 5.8vw, 5.2rem); line-height: 0.96; letter-spacing: -0.045em; }
      h2.mega { font-size: clamp(3.6rem, 9vw, 8rem); line-height: 0.9; }
      .w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0.06em 0 0.14em; margin: -0.06em 0 -0.14em; }
      .wi { display: inline-block; will-change: transform; }
      .lead { margin: 0; font-size: clamp(1.12rem, 1.55vw, 1.35rem); line-height: 1.5; color: rgba(255, 255, 255, 0.85); max-width: 34rem; }
      .pts { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, 0.28); }
      .pts li { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; font-size: 1.1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.28); font-weight: 600; letter-spacing: -0.01em; }
      .pts b { font: 500 12px/1.6 var(--mono); color: var(--yellow); }
      .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; margin-top: 32px; }
      .btn { display: inline-flex; align-items: center; background: var(--yellow); color: var(--blue); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; padding: 17px 28px; border-radius: 999px; text-decoration: none; transition: transform 0.25s, background 0.25s; }
      .btn { gap: 12px; }
      .arr { display: inline-block; transition: transform 0.3s cubic-bezier(.2, .7, .2, 1); }
      .btn:hover .arr { transform: translateX(4px); }
      .btn:hover { transform: translateY(-2px); background: #fff; }
      .btn:active { transform: scale(0.98); }
      .lnk { color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(255, 255, 255, 0.4); transition: color 0.2s; }
      .lnk:hover { color: var(--yellow); }
      .chatrow { margin: 22px 0 6px; }
      .sec.info { padding-bottom: 110px; }
      .ftr a { color: inherit; text-decoration: none; transition: color 0.2s; }
      .ftr a:hover { color: var(--yellow); }
      .ftr { position: absolute; left: var(--gut); right: var(--gut); bottom: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7; }
      .ftr-links { display: flex; flex-wrap: wrap; gap: 10px 20px; }
      @media (hover: none) {
        .btn:hover { transform: none; background: var(--yellow); }
        .btn:hover .arr { transform: none; }
        .chip:hover { color: inherit; background: none; border-color: rgba(255, 255, 255, 0.3); }
        .chip:hover .dot { background: var(--yellow); }
        .lnk:hover, .ftr a:hover, .nav a:hover { color: inherit; }
        .nav a.on { color: var(--yellow); }
        .band:hover .track { animation-play-state: running; }
      }
      @media (pointer: coarse) {
        html { -webkit-tap-highlight-color: transparent; }
        .nav a { padding: 12px 0; }
        .nav a::after { bottom: 6px; }
        .lnk { display: inline-block; padding: 12px 0; }
        .ftr a { padding: 12px 0; }
        .ftr, .ftr-links { gap: 0 20px; }
        .sec.info { padding-bottom: 150px; }
      }
      @media (max-width: 1023px) {
        .big { font-size: 32.5vw; }
        h2 { margin: 14px 0 14px; }
        .pts { margin-top: 22px; }
        .pts li { padding: 12px 0; font-size: 1rem; }
      }
      @media (min-width: 1024px) {
        .sec { align-items: center; padding-bottom: 0; }
        .txt { max-width: min(38rem, 47vw); }
        .sec.info { padding-bottom: 0; }
      }

      canvas.loader { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 100; pointer-events: none; }
      .loader-ui { position: fixed; inset: 0; z-index: 101; pointer-events: none; font: 500 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: #fff; }
      .loader-ui span { position: absolute; left: 0; top: 0; white-space: nowrap; will-change: transform; }
      .loader-ui .corner { left: clamp(16px, 3vw, 40px); }
    </style>

    <script>
      import * as THREE from 'three';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      gsap.registerPlugin(ScrollTrigger);

      const KF = [
        { ax: 0, ay: 0, ahw: 0.5, ahh: 0.5, ar: 0.5, bx: 0, by: 0, bhw: 0.5, bhh: 0.5, br: 0.5, det: 0, notch: 0, link: 0, amt: 0 },
        { ax: 0, ay: 4, ahw: 44, ahh: 30, ar: 7, bx: 30, by: -20, bhw: 17, bhh: 11, br: 4, det: 1, notch: 0, link: 0, amt: 1 },
        { ax: -10, ay: 0, ahw: 22, ahh: 38, ar: 11, bx: 14, by: 16, bhw: 12, bhh: 12, br: 12, det: 0, notch: 1, link: 0, amt: 1 },
        { ax: -26, ay: 0, ahw: 13, ahh: 13, ar: 13, bx: 26, by: 0, bhw: 13, bhh: 13, br: 13, det: 0, notch: 0, link: 1, amt: 1 },
        { ax: -13, ay: 0, ahw: 27, ahh: 27, ar: 27, bx: 13, by: 0, bhw: 27, bhh: 27, br: 27, det: 0, notch: 0, link: 0, amt: 1 },
      ];
      const st: Record<string, number> = { ...KF[0], grid: 0, mg: 0 };
      let lenis: Lenis | undefined;

      const mark = document.getElementById('mark')!;
      gsap.set('.chi', { yPercent: 110 });
      const showAll = (hdrDelay = 0.1) => {
        gsap.to(st, { grid: 1, mg: 1, duration: 1.6, delay: hdrDelay + 0.2, ease: 'power2.out' });
        gsap.fromTo('.word, .nav', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.6, delay: hdrDelay });
        gsap.set('.big', { autoAlpha: 1 });
        gsap.to('.chi', { yPercent: 0, duration: 1.1, ease: 'expo.out', stagger: 0.07 });
      };
      const seen = () => {
        try {
          return sessionStorage.getItem('pd-intro') === '1';
        } catch {
          return false;
        }
      };

      const hex = (h: string) => new THREE.Vector3(...([1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255) as [number, number, number]));

      function runLoader() {
        const root = document.documentElement;
        root.style.overflow = 'hidden';

        const canvas = document.createElement('canvas');
        canvas.className = 'loader';
        const ui = document.createElement('div');
        ui.className = 'loader-ui';
        ui.innerHTML = '<span id="lR"></span><span class="corner" id="lC"></span><span id="lW">Web.2</span>';
        document.body.append(canvas, ui);
        const $ = (id: string) => ui.querySelector<HTMLElement>('#' + id)!;
        const lR = $('lR'), lC = $('lC'), lW = $('lW');

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, premultipliedAlpha: true });
        const dpr = Math.min(devicePixelRatio, 2);
        renderer.setPixelRatio(dpr);
        renderer.setSize(innerWidth, innerHeight, false);

        const u = {
          uRes: { value: new THREE.Vector2(innerWidth * dpr, innerHeight * dpr) },
          uDpr: { value: dpr },
          uC: { value: new THREE.Vector2() },
          uK: { value: 1 },
          uDist: { value: 46 },
          uR: { value: 0 },
          uGrid: { value: 0 },
          uLine: { value: 0 },
          cA: { value: hex('#ffffff') },
          cB: { value: hex('#ffe000') },
          cCut: { value: hex('#0034d6') },
        };
        const blueV = hex('#0034d6'), whiteV = hex('#ffffff');
        const mesh = new THREE.Mesh(
          new THREE.PlaneGeometry(2, 2),
          new THREE.ShaderMaterial({
            uniforms: u,
            transparent: true,
            depthTest: false,
            vertexShader: 'void main(){gl_Position=vec4(position.xy,0.,1.);}',
            fragmentShader: `
              precision highp float;
              uniform vec2 uRes, uC; uniform float uK, uDist, uR, uGrid, uLine, uDpr; uniform vec3 cA, cB, cCut;
              vec4 over(vec4 d, vec3 c, float a){ return vec4(c*a, a) + d*(1.-a); }
              float cov(float d, float t){ return clamp(t*.5 + .5 - abs(d), 0., 1.); }
              void main(){
                vec2 fc = gl_FragCoord.xy;
                vec2 p = fc - uC;

                float cell = 28.*uDpr;
                vec2 g = mod(fc - uRes*.5 + cell*.5, cell) - cell*.5;
                float dotA = clamp(1.3*uDpr - length(g), 0., 1.);
                float fall = 1. - smoothstep(.12, .7, length(fc - uRes*.5)/max(uRes.x, uRes.y));
                float ga = dotA*fall*.42*uGrid;

                float h = cov(p.y, uDpr) * (1. - smoothstep(0., .5*uRes.x, abs(p.x)));
                float v = cov(p.x, uDpr) * (1. - smoothstep(0., .5*uRes.y, abs(p.y)));
                float sp = 10.*uK;
                float tx = abs(mod(p.x + sp*.5, sp) - sp*.5);
                float tick = cov(tx, uDpr) * clamp(5.*uDpr - abs(p.y), 0., 1.) * step(abs(p.x), 70.*uK);
                float la = max(max(h, v)*.22, tick*.55) * uLine;

                float ba = max(ga, la);
                vec4 c = vec4(vec3(ba), ba);

                float aA = clamp(.5 - (length(p - vec2(-uDist*uK, 0.)) - uR*uK), 0., 1.);
                float aB = clamp(.5 - (length(p - vec2( uDist*uK, 0.)) - uR*uK), 0., 1.);
                c = over(c, cA, aA);
                c = over(c, cB, aB);
                c = over(c, cCut, aA*aB);
                gl_FragColor = c;
              }`,
          }),
        );
        mesh.frustumCulled = false;
        const scene = new THREE.Scene();
        scene.add(mesh);
        const camera = new THREE.Camera();

        const big = Math.min(innerWidth * 0.62, innerHeight * 0.5, 520);
        const s = { cx: innerWidth / 2, cy: innerHeight / 2, size: big, dist: 46, r: 0, grid: 0, line: 0, ui: 1, flash: 0 };
        const target = () => mark.getBoundingClientRect();
        const onResize = () => {
          renderer.setSize(innerWidth, innerHeight, false);
          u.uRes.value.set(innerWidth * dpr, innerHeight * dpr);
          if (tl.time() < tl.labels.fly) {
            s.cx = innerWidth / 2;
            s.cy = innerHeight / 2;
            s.size = Math.min(innerWidth * 0.62, innerHeight * 0.5, 520);
          }
          draw();
        };
        addEventListener('resize', onResize);
        const place = (el: HTMLElement, x: number, y: number) => (el.style.transform = `translate(${x}px, ${y}px)`);

        let tl: gsap.core.Timeline;
        const draw = () => {
          const k = s.size / 100;
          u.uC.value.set(s.cx * dpr, (innerHeight - s.cy) * dpr);
          u.uK.value = k * dpr;
          u.uDist.value = s.dist;
          u.uR.value = s.r;
          u.uGrid.value = s.grid;
          u.uLine.value = s.line;
          u.cCut.value.lerpVectors(blueV, whiteV, s.flash);
          renderer.render(scene, camera);

          const o = String(s.line * s.ui);
          lR.style.opacity = lC.style.opacity = lW.style.opacity = o;
          lR.textContent = 'Δ ' + (s.dist * 2).toFixed(1).padStart(5, '0');
          place(lR, s.cx - lR.offsetWidth / 2, s.cy + Math.max(s.r, 5) * k + 14);
          const pct = Math.round(Math.min(1, tl.time() / tl.labels.fly) * 100);
          lC.textContent = String(pct).padStart(3, '0') + '%';
          place(lC, 0, innerHeight - 30);
          place(lW, innerWidth - lW.offsetWidth - Math.max(16, innerWidth * 0.03), innerHeight - 30);
        };

        tl = gsap
          .timeline({
            onUpdate: draw,
            onComplete: () => {
              gsap.set(mark, { autoAlpha: 1 });
              canvas.remove();
              ui.remove();
              renderer.dispose();
              root.style.overflow = '';
              lenis?.start();
              removeEventListener('resize', onResize);
              try {
                sessionStorage.setItem('pd-intro', '1');
              } catch {}
            },
          })
          .to(s, { grid: 1, line: 1, duration: 0.5, ease: 'power2.out' })
          .to(s, { r: 5, duration: 0.55, ease: 'back.out(2.2)' }, '-=0.2')
          .to(s, { duration: 0.3 })
          .to(s, { dist: 13, r: 27, duration: 1.1, ease: 'expo.inOut' })
          .to(s, { duration: 0.4 })
          .addLabel('fly')
          .to(s, { grid: 0, line: 0, duration: 0.45, ease: 'power2.in' }, 'fly')
          .to(s, { cx: () => target().left + target().width / 2, cy: () => target().top + target().height / 2, size: () => target().width, duration: 1, ease: 'power3.inOut' }, 'fly')
          .add(() => showAll(0.55), 'fly+=0.5');      }

      const instant = () => {
        gsap.set(mark, { autoAlpha: 1 });
        showAll();
      };
      function initSite(willLoad: boolean, reduced: boolean) {
        const canvas = document.getElementById('bg') as HTMLCanvasElement;
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, premultipliedAlpha: true });
        const dpr = Math.min(devicePixelRatio, innerWidth < 700 ? 1.5 : 2);
        renderer.setPixelRatio(dpr);
        renderer.setSize(innerWidth, innerHeight, false);
        const u = {
          uRes: { value: new THREE.Vector2() }, uAnchor: { value: new THREE.Vector2() }, uMouse: { value: new THREE.Vector2(-9999, -9999) },
          uDpr: { value: dpr }, uK: { value: 1 }, uTime: { value: 0 }, uGrid: { value: 0 }, uLink: { value: 0 },
          uAmt: { value: 0 }, uDetB: { value: 0 }, uDetP: { value: 0 }, uMg: { value: 0 },
          uA: { value: new THREE.Vector4() }, uB: { value: new THREE.Vector4() }, uR: { value: new THREE.Vector2() },
          cA: { value: hex('#ffffff') }, cB: { value: hex('#ffe000') }, cCut: { value: hex('#0034d6') },
        };
        const mesh = new THREE.Mesh(
          new THREE.PlaneGeometry(2, 2),
          new THREE.ShaderMaterial({
            uniforms: u, transparent: true, depthTest: false,
            vertexShader: 'void main(){gl_Position=vec4(position.xy,0.,1.);}',
            fragmentShader: `
              precision highp float;
              uniform vec2 uRes, uMouse, uR, uAnchor; uniform float uDpr, uK, uTime, uGrid, uLink, uAmt, uDetB, uDetP, uMg;
              uniform vec4 uA, uB; uniform vec3 cA, cB, cCut;
              vec4 over(vec4 d, vec3 c, float a){ return vec4(c*a, a) + d*(1.-a); }
              float cv(float d){ return clamp(.5 - d, 0., 1.); }
              float sdBox(vec2 p, vec2 b, float r){ r = min(r, min(b.x, b.y)); vec2 q = abs(p) - b + r; return length(max(q, 0.)) + min(max(q.x, q.y), 0.) - r; }
              float bx(vec2 fc, vec2 off, vec2 hs, float r){ return cv(sdBox(fc - uA.xy - off*uK, hs*uK, r*uK)); }
              void main(){
                vec2 fc = gl_FragCoord.xy;
                float cell = 28.*uDpr;
                vec2 g = mod(fc + cell*.5, cell) - cell*.5;
                vec2 cid = floor((fc + cell*.5)/cell);
                float md = length(fc - uMouse)/(220.*uDpr);
                float glow = exp(-md*md*2.5)*uMg;
                float ph = sin(uTime*.9 + cid.x*.35 + cid.y*.28)*.5 + .5;
                float dotA = clamp((1.2 + .5*ph + 1.5*glow)*uDpr - length(g), 0., 1.);
                float ga = dotA*(.14 + .55*glow)*uGrid;
                vec2 uv = fc/uRes;
                float vig = smoothstep(.25, 1.05, length((uv - .5)*vec2(1., .9)))*(1. - .6*uv.y)*.5;
                vec4 c = vec4(vec3(0., .03, .35)*vig, vig);
                float gd = length(fc - uAnchor)/(uRes.y*.55);
                c = over(c, vec3(.55, .7, 1.), exp(-gd*gd*1.6)*.16*uAmt);
                c = over(c, vec3(1.), ga);

                vec2 pa = fc - uA.xy, pb = fc - uB.xy;
                float aA = cv(sdBox(pa, uA.zw, uR.x))*uAmt;
                float aB = cv(sdBox(pb, uB.zw, uR.y))*uAmt;

                vec2 ab = uB.xy - uA.xy;
                float t = clamp(dot(fc - uA.xy, ab)/max(dot(ab, ab), 1.), 0., 1.);
                c = over(c, vec3(1.), cv(length(fc - uA.xy - ab*t) - 1.2*uDpr)*uLink*.5);
                vec2 pp = uA.xy + ab*fract(uTime*.35);
                c = over(c, cB, cv(length(fc - pp) - 4.5*uDpr)*uLink);

                c = over(c, cA, aA);

                float det = 0.;
                for (int i = 0; i < 3; i++){
                  vec2 o = vec2(-uA.z/uK + 9. + 7.*float(i), uA.w/uK - 9.);
                  det = max(det, bx(fc, o, vec2(2.4), 2.4)*uDetB);
                }
                c = over(c, cCut, det*aA);
                float bars = max(bx(fc, vec2(-14., 6.), vec2(26., 3.4), 1.7), bx(fc, vec2(-22., -3.), vec2(18., 2.2), 1.1))*uDetB
                           + (bx(fc, vec2(0., 6.), vec2(16., 12.), 3.) + bx(fc, vec2(0., -12.), vec2(14., 2.4), 1.2) + bx(fc, vec2(0., -19.), vec2(10., 2.), 1.))*uDetP;
                c = over(c, cCut, clamp(bars, 0., 1.)*.2*aA);
                float notch = bx(fc, vec2(0., uA.w/uK - 7.), vec2(6., 1.8), 1.8)*uDetP;
                c = over(c, cCut, notch*aA);

                c = over(c, cB, aB);
                c = over(c, cCut, aA*aB);
                c = over(c, vec3(step(.5, fract(sin(dot(fc, vec2(12.9898, 78.233)))*43758.5453))), .014);
                gl_FragColor = c;
              }`,
          }),
        );
        mesh.frustumCulled = false;
        const scene = new THREE.Scene();
        scene.add(mesh);
        const camera = new THREE.Camera();

        let tx = 0, ty = 0, mx = 0, my = 0, mpx = -9999, mpy = -9999, gx = -9999, gy = -9999;
        addEventListener('pointermove', (e) => {
          tx = e.clientX / innerWidth - 0.5; ty = e.clientY / innerHeight - 0.5; mpx = e.clientX; mpy = e.clientY;
          if (gx < -9000) { gx = mpx; gy = mpy; }
        });
        let freeBottom = innerHeight;
        let segs: { a: number; b: number }[] = [];
        const measure = () => {
          freeBottom = Math.min(...[...document.querySelectorAll<HTMLElement>('.sec .txt')].map((t) => t.offsetTop));
          const vh = innerHeight;
          segs = ['web', 'social', 'ai', 'info'].map((id, i) => {
            const top = document.getElementById(id)!.getBoundingClientRect().top + scrollY;
            return i === 0 ? { a: top - vh * 0.55, b: top - vh * 0.1 } : { a: top - vh * 0.95, b: top - vh * 0.25 };
          });
        };
        const keys = Object.keys(KF[0]);
        const shapeTarget = (y: number) => {
          let i = -1;
          while (i + 1 < segs.length && y >= segs[i + 1].a) i++;
          if (i < 0) return KF[0];
          const { a, b } = segs[i], p = Math.min(1, Math.max(0, (y - a) / (b - a)));
          const from = KF[i] as Record<string, number>, to = KF[i + 1] as Record<string, number>;
          return Object.fromEntries(keys.map((k) => [k, from[k] + (to[k] - from[k]) * p]));
        };
        measure();
        document.fonts?.ready.then(measure);
        addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight, false); measure(); });

        gsap.ticker.add((time, dt) => {
          const tgt = shapeTarget(scrollY) as Record<string, number>, ease = 1 - Math.exp(-dt / 110);
          for (const key of keys) st[key] += (tgt[key] - st[key]) * ease;
          const w = innerWidth, h = innerHeight, wide = w >= 1024;
          const top = 92, avail = Math.max(120, freeBottom - top - 20);
          const cx = wide ? w * 0.7 : w * 0.5, cy = wide ? h * 0.5 : h * 0.31;
          const S = wide ? Math.min(w * 0.46, h * 0.86) : Math.min(w * 0.6, h * 0.32);
          const k = (S / 100) * dpr;
          mx += (tx - mx) * 0.06; my += (ty - my) * 0.06;
          gx += (mpx - gx) * 0.15; gy += (mpy - gy) * 0.15;
          const fl = Math.sin(time * 0.8) * 1.2;
          const oy = (h - cy) * dpr;
          u.uRes.value.set(w * dpr, h * dpr); u.uAnchor.value.set(cx * dpr, oy);
          u.uK.value = k; u.uTime.value = time;
          u.uA.value.set((cx * dpr) + (st.ax + mx * 5) * k, oy + (st.ay + fl - my * 4) * k, st.ahw * k, st.ahh * k);
          u.uB.value.set((cx * dpr) + (st.bx - mx * 5) * k, oy + (st.by - fl - my * 4) * k, st.bhw * k, st.bhh * k);
          u.uR.value.set(st.ar * k, st.br * k);
          u.uGrid.value = st.grid; u.uLink.value = st.link; u.uAmt.value = st.amt * (wide ? 1 : 0.82);
          u.uDetB.value = st.det; u.uDetP.value = st.notch; u.uMg.value = st.mg;
          u.uMouse.value.set(gx * dpr, (h - gy) * dpr);
          renderer.render(scene, camera);
        });

        if (!reduced) {
          lenis = new Lenis({ lerp: 0.09 });
          if (willLoad) lenis.stop();
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((t) => lenis!.raf(t * 1000));
          gsap.ticker.lagSmoothing(0);
        }

        document.querySelectorAll<HTMLAnchorElement>('.nav a, .brand').forEach((a) =>
          a.addEventListener('click', (e) => {
            const href = a.getAttribute('href')!;
            const target = href === '/' ? 0 : document.querySelector<HTMLElement>(href);
            if (target === null) return;
            e.preventDefault();
            if (lenis) lenis.scrollTo(target as any, { duration: 1.4 });
            else if (target === 0) scrollTo({ top: 0, behavior: 'smooth' });
            else (target as HTMLElement).scrollIntoView({ behavior: 'smooth' });
          }),
        );

        document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
          const text = el.textContent!.trim();
          el.setAttribute('aria-label', text);
          el.innerHTML = text.split(' ').map((wd) => `<span class="w" aria-hidden="true"><span class="wi">${wd}</span></span>`).join(' ');
        });

        document.querySelectorAll<HTMLElement>('.sec').forEach((sec) => {
          gsap.timeline({ scrollTrigger: { trigger: sec, start: 'top 50%', toggleActions: 'play none none reverse' } })
            .from(sec.querySelectorAll('.wi'), { yPercent: 110, duration: 1, ease: 'expo.out', stagger: 0.05 })
            .from(sec.querySelectorAll('.rv'), { y: 24, autoAlpha: 0, duration: 0.8, ease: 'power3.out', stagger: 0.08 }, '-=0.8');
        });

        const prog = document.querySelector<HTMLElement>('.prog')!;
        ScrollTrigger.create({ start: 0, end: 'max', onUpdate: (self) => (prog.style.transform = `scaleX(${self.progress})`) });
        document.querySelectorAll<HTMLAnchorElement>('.nav a').forEach((a) => {
          ScrollTrigger.create({ trigger: a.getAttribute('href')!, start: 'top 50%', end: 'bottom 50%',
            onToggle: (self) => { a.classList.toggle('on', self.isActive); self.isActive ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'); } });
        });

      }

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const willLoad = !(reduced || seen());
      try {
        initSite(willLoad, reduced);
      } catch {
        /* WebGL unavailable: content stays readable without the scene */
      }
      if (!willLoad) {
        instant();
      } else {
        try {
          runLoader();
        } catch {
          document.documentElement.style.overflow = '';
          lenis?.start();
          instant();
        }
      }
    </script>
  </body>
</html>
