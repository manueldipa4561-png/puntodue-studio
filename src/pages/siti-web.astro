---
import Site from '../layouts/Site.astro';
import Servizio from '../components/Servizio.astro';
const features = [
  { t: 'Design su misura', d: 'Pensato per il tuo settore e ottimizzato per lo smartphone.' },
  { t: 'Caricamento veloce', d: 'Pagine leggere, pensate per aprirsi in fretta.' },
  { t: 'Prenotazione online', d: 'Chi visita il sito può prenotare o chiedere un preventivo senza giri.' },
  { t: 'Privacy e cookie', d: 'Informativa privacy e cookie inclusa nel servizio.' },
  { t: 'Su richiesta', d: 'Shop online, acconti, tessera fedeltà e promemoria via WhatsApp.' },
];
const steps = [
  { t: 'Ci racconti l’attività', d: 'Scrivici su WhatsApp o dal modulo: la richiesta arriva direttamente a chi segue il progetto.' },
  { t: 'Ricevi il preventivo', d: 'Dopo un primo colloquio per definire le esigenze, ti inviamo un preventivo dettagliato.' },
  { t: 'Il sito va online', d: 'Entro 2 settimane da quando riceviamo testi, foto, orari e prezzi.' },
];
const terms = [
  'Da 200 € al mese, senza anticipi annuali. Il canone varia con il numero di pagine e le funzioni richieste.',
  'Contratto di 6 o 12 mesi, a tua scelta, senza rinnovo automatico.',
  'Un mese di garanzia dalla pubblicazione e 2 revisioni al mese per ogni sito.',
  'Dominio, account e contenuti restano tuoi. Dominio e hosting non sono nel canone: un dominio .it costa circa 12 € + IVA all’anno.',
];
---
<Site title="Agenzia siti web in tutta Italia — Punto Due Studio" description="Siti web su misura, veloci e pensati per il telefono: online in 2 settimane dai contenuti, canone mensile da 200 € e nessun rinnovo automatico.">
  <Servizio label="/siti-web" h1="Un sito che lavora per te." lead="Siti web per aziende e professionisti in tutta Italia: veloci, chiari e fatti per far scrivere o prenotare chi li visita." serviceName="Realizzazione siti web" features={features} steps={steps} terms={terms} more={{ href: '/web/', t: 'Guarda le demo' }} />
</Site>
