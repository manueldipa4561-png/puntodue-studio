      /* KERN phone: own palette (night / bone / lime) */
      .k-wrap { display: grid; justify-items: center; gap: 16px; }
      .k-ctl { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
      .k-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.4); border-radius: 999px; overflow: hidden; }
      .k-seg button { background: none; border: 0; color: #fff; padding: 8px 14px; font: 600 .8rem 'Inter Tight Variable', system-ui, sans-serif; cursor: pointer; }
      .k-seg button[aria-pressed="true"] { background: var(--yellow); color: #000; }
