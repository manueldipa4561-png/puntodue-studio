---
import Site from '../layouts/Site.astro';
import Sim from '../components/Sim.astro';
import Chat from '../components/Chat.astro';
import Bi from '../components/Bi.astro';
const WA = `https://wa.me/393248423657?text=${encodeURIComponent('Ciao! Ho visto le vostre demo e vorrei parlarvi di un progetto.')}`;
const demos = [
  { slug: 'hair', name: 'SEZIONE', kind: 'Hair studio', line: 'Il sito di un salone, per lei e per lui.', tags: ['Lei / Lui', 'WebGL', 'Prenotazione'], next: ['Prenotazione con conferma su WhatsApp','Tessera fedeltà: ogni 6 servizi il 7° è in regalo', 'Coupon −15% sulla prima visita', 'Promemoria su WhatsApp prima della visita'] },
  { slug: 'innesto', name: 'INNESTO', kind: 'Ristrutturazioni', line: 'Ristrutturazioni chiavi in mano, con slider prima/dopo.', tags: ['Prima / Dopo', 'Case study', 'Sopralluogo'], next: ['Preventivo guidato in 4 domande', 'Area cliente con avanzamento del cantiere', 'Coupon sopralluogo gratuito a tempo', 'Sconto referral per chi consiglia lo studio'] },
  { slug: 'tattoo', name: 'Cultura Tattoo', kind: 'Tattoo studio', line: 'Tatuaggi su misura in bianco e nero, dal lucido alla pelle.', tags: ['Lettore di lucidi', 'Consulenza', 'Acconto'], next: ['Acconto online del 30% scalato dal totale', 'Promemoria WhatsApp 48 ore prima della seduta', 'Tessera a timbri: alla 5ª seduta −15%', 'Porta un amico: −10% a chi presenti'] },
];
const stats = [
  { t: 'Probabilità di vendere', a: { l: 'Nuovo contatto', v: 12.5, r: '5–20%' }, b: { l: 'Cliente già acquisito', v: 65, r: '60–70%' }, max: 100 },
  { t: 'Costo per ottenere un cliente', a: { l: 'Mantenerne uno', v: 1, r: '1×' }, b: { l: 'Trovarne uno nuovo', v: 15, r: '5–25×' }, max: 25 },
  { t: 'Profitto con +5% di clienti fedeli', a: { l: 'Oggi', v: 0, r: '—' }, b: { l: 'Con +5% di retention', v: 60, r: '+25–95%' }, max: 100 },
];
const feats = [
  { id: 'sito', t: 'Sito veloce', d: 'Più contatti ogni mese', n: 0.15, r: 0 },
  { id: 'fed', t: 'Tessera fedeltà', d: 'I clienti tornano più spesso', n: 0, r: 0.12 },
  { id: 'cp', t: 'Coupon', d: 'Riporta chi si era perso', n: 0.1, r: 0.05 },
  { id: 'wa', t: 'Promemoria WhatsApp', d: 'Meno appuntamenti saltati', n: 0, r: 0.06 },
  { id: 'ref', t: 'Referral', d: 'I clienti portano amici', n: 0.2, r: 0.02 },
];
const kstats = [
  { t: { it: 'Giovani USA incerti sul percorso', en: 'US young adults unsure about their path' },
    a: { l: { it: 'Incerti sulla carriera, 18–30', en: 'Unsure about career, 18–30' }, v: 66.7, r: { it: '≈ 2 su 3', en: '≈ 2 in 3' } },
    b: { l: { it: 'Gen Z, incerti sui lavori futuri', en: 'Gen Z, unsure about future jobs' }, v: 33.3, r: { it: '≈ 1 su 3', en: '≈ 1 in 3' } }, max: 100 },
  { t: { it: 'Le aziende dicono «competenze». Assumono altrimenti.', en: 'Employers say "skills". They hire otherwise.' },
    a: { l: { it: 'Assunzioni entry-level per competenze', en: 'Entry-level hires based on skills' }, v: 70, r: { it: '70%', en: '70%' } },
    b: { l: { it: "Assunti senza laurea dove l'hanno tolta", en: 'Hires without a degree where it was dropped' }, v: 0.14, r: { it: '< 1 su 700', en: '< 1 in 700' } }, max: 100 },
  { t: { it: 'Disoccupazione, giugno 2026', en: 'Unemployment, June 2026' },
    a: { l: { it: 'Tutti i lavoratori', en: 'All workers' }, v: 4, r: { it: '≈ 4%', en: '≈ 4%' } },
    b: { l: { it: 'Neolaureati, 22–27', en: 'Recent graduates, 22–27' }, v: 5.7, r: { it: '5,7%', en: '5.7%' } }, max: 10 },
];
const vs = [
  { who: { it: 'Forage', en: 'Forage' }, from: { it: 'Parte da un ruolo', en: 'Starts from a role' }, gap: { it: 'Certifica che hai finito, non chi sei.', en: 'Certifies you finished, not who you are.' } },
  { who: { it: 'Parker Dewey', en: 'Parker Dewey' }, from: { it: 'Parte da un campo scelto', en: 'Starts from a chosen field' }, gap: { it: "Guidato dall'azienda; non per chi sta ancora scegliendo.", en: 'Employer-led; not for people still choosing.' } },
  { who: { it: 'Riipen', en: 'Riipen' }, from: { it: 'Parte da un corso', en: 'Starts from a course' }, gap: { it: 'Serve essere iscritti a una scuola.', en: 'You need to be enrolled in a school.' } },
  { who: { it: 'Contra, Dribbble', en: 'Contra, Dribbble' }, from: { it: 'Parte da un mestiere che hai già', en: 'Starts from a trade you already have' }, gap: { it: 'Presuppone un portfolio.', en: 'Assumes a portfolio.' } },
  { who: { it: 'Quiz di carriera', en: 'Career quizzes' }, from: { it: 'Parte dalle tue risposte', en: 'Starts from your answers' }, gap: { it: 'Non fai nulla, quindi nessuna prova.', en: 'You do nothing, so there is no proof.' } },
  { who: { it: 'KERN', en: 'KERN' }, from: { it: 'Parte dalla persona', en: 'Starts from the person' }, gap: { it: 'Lavoro vero come esperimento su di te, con le prove accanto.', en: 'Real work as an experiment on you, with the evidence attached.' }, me: true },
];
---
<Site title="Lavori e demo — Punto Due Studio" description="Tre demo di siti complete e cliccabili, più KERN, un'app in concept che aiuta a scoprire cosa fare facendo lavoro vero." active="web">
      <section class="app" id="app">
        <div class="app-txt">
          <span class="lab">/app · concept</span>
          <svg class="icon" viewBox="0 0 100 100" role="img" aria-label="Icona app KERN">
            <rect width="100" height="100" rx="23" fill="#0F140E" />
            <g stroke="#E8E6DA"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" fill="#E8E6DA" stroke="none" transform="translate(-5 -5)"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" transform="translate(5 5)"/><circle cx="66.4" cy="66.4" r="9" fill="#C9F24A" stroke="none"/></g>
          </svg>
          <h2 class="k-h">kern<span>.</span></h2>
          <p class="lead">Scopri cosa vuoi fare facendo lavoro vero. Missioni reali di aziende vere, tante risposte per ogni missione, e yourKERN: un profilo che nasce da ciò che hai fatto, non da ciò che dici di volere.</p>
          <dl class="spec">
            <div><dt>Piattaforme</dt><dd>iOS · Android · Web app</dd></div>
            <div><dt>Stato</dt><dd>Concept, in sviluppo</dd></div>
            <div><dt>Lingua</dt><dd>Inglese, poi altre</dd></div>
            <div><dt>Per chi</dt><dd>Dai 18 ai 35 anni</dd></div>
            <div><dt>Dati</dt><dd>Mai venduti</dd></div>
          </dl>
          <ul class="feat">
            <li><b>Missioni aperte a tutti</b><span>Nessun blocco e nessun cronometro. Ogni missione accetta più risposte, così provi strade diverse.</span></li>
            <li><b>Vince chi lo fa meglio</b><span>Non chi arriva prima. La classifica premia la qualità: revisione anonima tra pari e la scelta dell'azienda.</span></li>
            <li><b>yourKERN</b><span>Tempo passato, interessi e missioni completate, sempre con le prove accanto. Mai una diagnosi.</span></li>
          </ul>
        </div>

        <div class="k-wrap">
          <div class="k-ctl">
            <div class="k-seg" role="group" aria-label="Lingua"><button type="button" data-k-lang="en" aria-pressed="true">EN</button><button type="button" data-k-lang="it" aria-pressed="false">IT</button></div>
            <div class="k-seg" role="group" aria-label="Tema"><button type="button" data-k-theme="dark" aria-pressed="true">Dark</button><button type="button" data-k-theme="light" aria-pressed="false">Light</button></div>
          </div>
          <div class="phone" aria-label="Anteprima interattiva dell'app KERN">
            <div class="k-scr" id="kScr">
              <div class="k-load" id="kLoad" aria-hidden="true">
                <svg viewBox="0 0 100 100"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" class="ks" fill="currentColor"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" class="kl" stroke="currentColor"/><circle cx="66.4" cy="66.4" r="9" class="kc"/></svg>
                <div class="k-word">kern<i>.</i></div>
                <div class="k-tag"><span>Follow the trail.</span><strong>Find your<b>KERN</b>.</strong></div>
              </div>
              <div class="k-app">
                <div class="k-top">
                  <div class="k-logo"><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" fill="currentColor" transform="translate(-5 -5)"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" stroke="currentColor" transform="translate(5 5)"/><circle cx="66.4" cy="66.4" r="9"/></svg>kern<i>.</i></div>
                  <span class="k-pill">1 of 3 done</span>
                </div>
                <div class="k-body">
                  <div class="k-pane on" id="k-missions">
                    <div><div class="k-l">All missions open</div><h4>Pick your<br>next <b>move.</b></h4></div>
                    <div class="k-card k-main"><div class="k-l">Mission 002 · startup partner</div><h5>Fix what already exists</h5><p>Make a real startup's onboarding screen clearer. The opposite of starting from a blank page.</p><div class="k-l">128 answers · judged on quality</div><button type="button" class="k-btn" data-k-toast="Your answer is saved. Add another one anytime.">Add your answer</button></div>
                    <div class="k-card"><div class="k-l">Mission 003 · KERN</div><h5>Rewrite a confusing email</h5><p>Do it your way. Every answer counts.</p><div class="k-l">54 answers</div></div>
                    <div class="k-card"><div class="k-l">Mission 004 · studio client</div><h5>Work with a partner</h5><p>Answer together with someone else.</p><div class="k-l">31 answers</div></div>
                  </div>
                  <div class="k-pane" id="k-yourkern">
                    <div><div class="k-l">yourKERN · first signs</div><h4>Your <b>KERN</b><br>so far.</h4></div>
                    <div class="k-card"><div class="k-l">Time on KERN missions</div><div class="k-stat"><b>1h 15m</b><span class="k-l">this week · only you see this</span></div><div class="k-bar"><i></i></div></div>
                    <div class="k-card"><div class="k-l">What you seem drawn to</div><div class="k-chips"><span>Shaping ideas</span><span>Writing</span><span>Solo work</span></div></div>
                    <div class="k-card"><div class="k-l">A first guess</div><div class="k-sig">You seemed to light up on the open brief and drag on the polish.</div><div class="k-l">Why we think so: you tried 3 versions of the open brief, and you wrote "time flew".</div>
                      <div class="k-ask"><button type="button" class="k-yes" data-k-msg="Saved. This sharpens your KERN.">That feels right</button><button type="button" data-k-msg="Noted. We'll give this guess less weight.">Not really</button></div><div class="k-l k-fb" id="kFb" aria-live="polite"></div></div>
                    <div><div class="k-l">Completed</div><div class="k-done"><span>Make somebody care</span><small>MISSION 001</small></div></div>
                    <div class="k-card"><div class="k-l">Worth trying next</div><h5>Improve an existing product page</h5><p>Tests the part you seemed to drag on.</p></div>
                  </div>
                  <div class="k-pane" id="k-trail">
                    <div><div class="k-l">Your Trail</div><h4>Follow the<br><b>trail.</b></h4></div>
                    <div class="k-tr">
                      <div class="k-st fin"><h5>Make somebody care</h5><p>Build from zero · done</p></div>
                      <div class="k-st now"><h5>Fix what already exists</h5><p>Improve what exists · in progress</p></div>
                      <div class="k-st"><h5>Work with a partner</h5><p>Pair up · not started</p></div>
                      <div class="k-st"><h5>Your Kern card</h5><p>What we saw, why, and your next move</p></div>
                    </div>
                    <div class="k-card"><div class="k-l">Leave a sign</div><p>After each mission, leave one short tip for the next person.</p></div>
                  </div>
                </div>
                <div class="k-toast" id="kToast" role="status" aria-live="polite"></div>
                <nav class="k-tabs" aria-label="KERN">
                  <button type="button" class="on" data-k-tab="missions">Missions</button>
                  <button type="button" data-k-tab="yourkern">your<span>KERN</span></button>
                  <button type="button" data-k-tab="trail">Trail</button>
                </nav>
              </div>
            </div>
          </div>
          <button type="button" class="k-replay" id="kReplay">↻ Rivedi l'apertura</button>
        </div>
      </section>

      <div class="ana" id="ana" data-lang="it">
      <section class="why" id="perche">
        <div class="ana-top">
          <span class="lab"><Bi it="/perché" en="/why" /></span>
          <div class="k-seg" role="group" aria-label="Lingua / Language"><button type="button" data-ana-lang="it" aria-pressed="true">IT</button><button type="button" data-ana-lang="en" aria-pressed="false">EN</button></div>
        </div>
        <h2><Bi it="Chi non sa cosa vuole non trova una porta d'ingresso." en="If you don't know what you want, there's no way in." /></h2>
        <p class="lead"><Bi it="I giovani sono incerti, le aziende dicono di assumere per competenze e i posti d'ingresso calano. Sono dati di ricerca generali, non risultati di KERN." en="Young people are unsure, employers say they hire for skills, and entry-level roles are shrinking. General research, not KERN results." /></p>
        <div class="charts">
          {kstats.map((s) => (
            <figure class="chart">
              <figcaption><Bi it={s.t.it} en={s.t.en} /></figcaption>
              {[s.a, s.b].map((r, k) => (
                <div class="row">
                  <span><Bi it={r.l.it} en={r.l.en} /></span>
                  <b><Bi it={r.r.it} en={r.r.en} /></b>
                  <div class="track"><i class={k ? 'y' : 'w'} style={`--v:${Math.max((r.v / s.max) * 100, 1.5)}%`}></i></div>
                </div>
              ))}
            </figure>
          ))}
        </div>
        <p class="note"><Bi it="Barre indicative, alcune cifre da fonti secondarie. Le cause del calo degli annunci entry-level sono discusse: KERN non incolpa l'AI." en="Bars are indicative; some figures come from secondary sources. The causes of the entry-level drop are debated: KERN doesn't blame AI." /></p>
        <p class="note"><Bi it='Fonti: NACE Job Outlook 2026 · Tallo / Forbes 2025 · Big Brothers Big Sisters / Harris Poll 2025 · Harvard Business School e Burning Glass Institute · NPR e IBISWorld 2026. <a href="#fonti">Dettagli</a>' en='Sources: NACE Job Outlook 2026 · Tallo / Forbes 2025 · Big Brothers Big Sisters / Harris Poll 2025 · Harvard Business School &amp; Burning Glass Institute · NPR &amp; IBISWorld 2026. <a href="#fonti">Details</a>' /></p>
      </section>

      <section class="vs" id="differenza">
        <span class="lab"><Bi it="/differenza" en="/difference" /></span>
        <h2><Bi it="Tutti partono da un ruolo. KERN parte da te." en="Everyone starts from a role. KERN starts from you." /></h2>
        <p class="lead"><Bi it="Le missioni con aziende vere esistono già: sono la materia prima. L'idea è usarle come esperimento su di te." en="Real-company missions already exist. They're the raw material; the idea is to use them as an experiment on you." /></p>
        <ul class="vs-l">
          {vs.map((v) => (
            <li class={v.me ? 'me' : ''}><b><Bi it={v.who.it} en={v.who.en} /></b><span class="vs-f"><Bi it={v.from.it} en={v.from.en} /></span><span><Bi it={v.gap.it} en={v.gap.en} /></span></li>
          ))}
        </ul>
        <div class="goal">
          <span class="lab"><Bi it="L'obiettivo" en="The goal" /></span>
          <p><Bi it="Aiutarti a scoprire cosa vuoi facendo lavoro vero. Tre missioni in contrasto portano a una Kern card: un'ipotesi su come lavori, con le prove, che puoi confermare o respingere." en="Help you find out what you want by doing real work. Three contrasting missions lead to a Kern card: a hypothesis about how you work, with evidence, that you can confirm or reject." /></p>
          <ul class="goal-l">
            <li><Bi it="Nessun cronometro: il ritmo è tuo." en="No timers: your pace." /></li>
            <li><Bi it="Nessun blocco: tutte le missioni sono aperte." en="No locks: every mission is open." /></li>
            <li><Bi it="Più risposte per missione: vince chi lo fa meglio, non chi arriva prima." en="Many answers per mission: the best work wins, not the fastest." /></li>
          </ul>
        </div>
      </section>
      </div>


      <section class="top">
        <span class="lab">/web</span>
        <h1>Nuovo link.</h1>
        <p class="lead">Tre siti da aprire e toccare con mano. Un click e sei dentro.</p>
      </section>

      <section class="demos" aria-label="Demo">
        {demos.map((d, i) => (
          <article class="card">
            <div class="shot">
              <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{d.slug === 'hair' ? 'sezione.it' : d.slug === 'innesto' ? 'innesto.it' : 'culturatattoo.it'}</span></div>
              <div class="view" data-shot>
                <img class="poster" src={`/previews/${d.slug}.webp`} width="960" height="600" alt="" loading="lazy" decoding="async" />
                <iframe data-src={`/demo/${d.slug}/index.html`} title={`Anteprima ${d.name}`} scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
                <a class="cover" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener" aria-label={`Apri la demo ${d.name}`}><span>Apri la demo →</span></a>
              </div>
            </div>
            <div class="meta">
              <span class="lab">0{i + 1} · {d.kind}</span>
              <h3>{d.name}</h3>
              <p>{d.line}</p>
              <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
              <div class="next">
                <span class="lab">Prossime modifiche</span>
                <ul>{d.next.map((n) => <li>{n}</li>)}</ul>
              </div>
              <a class="lnk" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener">Apri la demo →</a>
            </div>
          </article>
        ))}
      </section>
      <section class="why" id="numeri">
        <span class="lab">/numeri</span>
        <h2>Far tornare un cliente vale di più.</h2>
        <p class="lead">Fedeltà e coupon servono a questo. Dati di ricerca generali, non risultati delle demo.</p>
        <div class="charts">
          {stats.map((s) => (
            <figure class="chart">
              <figcaption>{s.t}</figcaption>
              {[s.a, s.b].map((r, k) => (
                <div class="row">
                  <span>{r.l}</span>
                  <b>{r.r}</b>
                  <div class="track"><i class={k ? 'y' : 'w'} style={`--v:${(r.v / s.max) * 100}%`}></i></div>
                </div>
              ))}
            </figure>
          ))}
        </div>
        <p class="note">Le barre mostrano il centro dell'intervallo indicato dalle fonti.</p>
      </section>

      <Sim feats={feats} kpi={['Clienti attivi al 12° mese', 'Clienti che tornano', 'Nuovi clienti al mese']} heading="Accendi le funzioni." lead="Aggiungine una alla volta e guarda come cambiano i clienti in un anno." />

      <section class="cta-s">
        <Chat kind="sent" />
        <div class="cta">
          <a class="btn" href={WA} target="_blank" rel="noopener">Scrivici <span aria-hidden="true">→</span></a>
          <a class="lnk" href="mailto:projects@puntoduestudio.it">projects@puntoduestudio.it</a>
        </div>
      </section>

      <section class="src" id="fonti">
        <span class="lab">/fonti</span>
        <ol>
          <li>Amy Gallo, «The Value of Keeping the Right Customers», Harvard Business Review, ottobre 2014: aumentare la retention del 5% aumenta i profitti del 25–95%; acquisire un cliente costa 5–25 volte più che mantenerlo (dati di Fred Reichheld, Bain &amp; Company). <a href="https://hbr.org/2014/10/the-value-of-keeping-the-right-customers" target="_blank" rel="noopener">hbr.org</a></li>
          <li>P. Farris, N. Bendle, P. Pfeifer, D. Reibstein, <i>Marketing Metrics: The Definitive Guide to Measuring Marketing Performance</i>, Pearson, 2010: probabilità di vendita 5–20% a un nuovo contatto, 60–70% a un cliente esistente.</li>
          <li>Forbes su rapporto Tallo, maggio 2025, e Big Brothers Big Sisters / Harris Poll, 2025: incertezza dei giovani adulti sul percorso di carriera. <a href="https://www.forbes.com/sites/juliakorn/2025/05/20/new-report-50-of-young-adults-feel-isolated-in-career-planning/" target="_blank" rel="noopener">forbes.com</a> · <a href="https://www.bbbs.org/2025/09/career-confidence-in-crisis-new-report-from-big-brothers-big-sisters-shows-gen-zers-lack-critical-mentorship/" target="_blank" rel="noopener">bbbs.org</a></li>
          <li>NACE Job Outlook 2026 (70% usa assunzioni per competenze nei ruoli entry-level); TestGorilla 2025; Harvard Business School e Burning Glass Institute (meno di 1 nuovo assunto su 700 senza laurea nelle aziende che l'hanno tolta). Riassunti secondari: <a href="https://blog.theinterviewguys.com/the-state-of-skills-based-hiring/" target="_blank" rel="noopener">The Interview Guys</a> · <a href="https://testlify.com/skills-based-hiring-statistics/" target="_blank" rel="noopener">Testlify</a> · <a href="https://www.forbes.com/sites/terdawn-deboe/2026/08/10/employers-are-hiring-for-skills-over-degrees-now-ai-is-why/" target="_blank" rel="noopener">Forbes, agosto 2026</a></li>
          <li>NPR, agosto 2026 e IBISWorld: disoccupazione dei neolaureati (5,7% a giugno 2026) e mercato entry-level. <a href="https://www.npr.org/2026/08/18/nx-s1-5910677/recent-college-graduates-employment-job-artificial-intelligence" target="_blank" rel="noopener">npr.org</a> · <a href="https://www.ibisworld.com/blog/2026-job-market-leaves-new-grads-behind/1/1126/" target="_blank" rel="noopener">ibisworld.com</a></li>
          <li>Forage, Parker Dewey, Riipen, Contra: descrizione dai siti dei prodotti. <a href="https://www.theforage.com/simulations" target="_blank" rel="noopener">theforage.com</a> · <a href="https://www.parkerdewey.com/" target="_blank" rel="noopener">parkerdewey.com</a> · <a href="https://contra.com/" target="_blank" rel="noopener">contra.com</a></li>
          <li>Le demo INNESTO, SEZIONE e Cultura Tattoo sono concept realizzati da Punto Due Studio; i nomi e le attività sono fittizi. L'app KERN è un concept non ancora testato con utenti: schermate, nomi e numeri sono d'esempio.</li>
        </ol>
      </section>
</Site>

<style is:global>
      .top { padding-bottom: 24px; border-top: 1px solid rgba(255,255,255,.25); }
      .demos { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); padding-top: 24px; }
      .card { display: flex; flex-direction: column; gap: 18px; }
      .shot { border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.35); background: var(--blue); transition: border-color .25s, transform .35s cubic-bezier(.2,.7,.2,1); }
