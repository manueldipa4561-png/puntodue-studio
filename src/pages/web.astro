---
import Site from '../layouts/Site.astro';
import Sim from '../components/Sim.astro';
import Chat from '../components/Chat.astro';
import Bi from '../components/Bi.astro';
import '@fontsource-variable/bricolage-grotesque';
const WA = `https://wa.me/393248423657?text=${encodeURIComponent('Ciao! Ho visto le vostre demo e vorrei parlarvi di un progetto.')}`;
const demos = [
  { slug: 'hair', name: 'SEZIONE', kind: 'Hair studio', line: 'Il sito di un salone, per lei e per lui.', tags: ['Lei / Lui', 'WebGL', 'Tessera + QR'], next: ['Prenotazione con conferma su WhatsApp', 'Timbri aggiunti dallo staff scansionando il QR', 'Tessera salvabile nel Wallet del telefono', 'Promemoria su WhatsApp prima della visita'] },
  { slug: 'innesto', name: 'INNESTO', kind: 'Ristrutturazioni', line: 'Ristrutturazioni chiavi in mano: casa 3D, prima/dopo e stima in 4 domande.', tags: ['Casa 3D', 'Prima / Dopo', '3 pagine'], next: ['Preventivo guidato in 4 domande', 'Area cliente con avanzamento del cantiere', 'Coupon sopralluogo gratuito a tempo', 'Sconto referral per chi consiglia lo studio'] },
  { slug: 'brace', name: 'BRACE', kind: 'Smokehouse e vini naturali', line: 'Brisket affumicato 14 ore, vini naturali e tavolo prenotato con conferma su WhatsApp.', tags: ['Fumo in WebGL', 'Timeline 14 ore', 'Tessera + QR'], next: ['Acconto online per tenere da parte il brisket', 'Tessera con QR: alla 6ª cena il brisket è offerto', 'Coupon a tempo per riempire martedì e mercoledì', 'Porta un amico: un calice offerto a entrambi'] },
];
const stats = [
  { t: 'Probabilità di vendere', a: { l: 'Nuovo contatto', v: 12.5, r: '5–20%' }, b: { l: 'Cliente già acquisito', v: 65, r: '60–70%' }, max: 100 },
  { t: 'Costo per ottenere un cliente', a: { l: 'Mantenerne uno', v: 1, r: '1×' }, b: { l: 'Trovarne uno nuovo', v: 15, r: '5–25×' }, max: 25 },
  { t: 'Profitto con +5% di clienti fedeli', a: { l: 'Oggi', v: 0, r: '—' }, b: { l: 'Con +5% di retention', v: 60, r: '+25–95%' }, max: 100 },
];
const feats = [
  { id: 'sito', t: 'Sito veloce', d: 'Più contatti ogni mese', n: 0.15, r: 0 },
  { id: 'fed', t: 'Tessera fedeltà', d: 'I clienti tornano più spesso', n: 0, r: 0.12 },
  { id: 'cp', t: 'Coupon', d: 'Riporta chi si era perso', n: 0.1, r: 0.05 },
  { id: 'wa', t: 'Promemoria WhatsApp', d: 'Meno appuntamenti saltati', n: 0, r: 0.06 },
  { id: 'ref', t: 'Referral', d: 'I clienti portano amici', n: 0.2, r: 0.02 },
];
const kstats = [
  { t: { it: 'Giovani USA incerti sul percorso', en: 'US young adults unsure about their path' },
    a: { l: { it: 'Incerti sulla carriera, 18–30', en: 'Unsure about career, 18–30' }, v: 66.7, r: { it: '≈ 2 su 3', en: '≈ 2 in 3' } },
    b: { l: { it: 'Gen Z, incerti sui lavori futuri', en: 'Gen Z, unsure about future jobs' }, v: 33.3, r: { it: '≈ 1 su 3', en: '≈ 1 in 3' } }, max: 100 },
  { t: { it: 'Le aziende dicono «competenze». Assumono altrimenti.', en: 'Employers say "skills". They hire otherwise.' },
    a: { l: { it: 'Assunzioni entry-level per competenze', en: 'Entry-level hires based on skills' }, v: 70, r: { it: '70%', en: '70%' } },
    b: { l: { it: "Assunti senza laurea dove l'hanno tolta", en: 'Hires without a degree where it was dropped' }, v: 0.14, r: { it: '< 1 su 700', en: '< 1 in 700' } }, max: 100 },
  { t: { it: 'Disoccupazione, giugno 2026', en: 'Unemployment, June 2026' },
    a: { l: { it: 'Tutti i lavoratori', en: 'All workers' }, v: 4, r: { it: '≈ 4%', en: '≈ 4%' } },
    b: { l: { it: 'Neolaureati, 22–27', en: 'Recent graduates, 22–27' }, v: 5.7, r: { it: '5,7%', en: '5.7%' } }, max: 10 },
];
---
<Site title="Lavori e demo — Punto Due Studio" description="Tre demo di siti complete e cliccabili, più KERN, un'app in concept che aiuta a scoprire cosa fare facendo lavoro vero." active="web">
      <section class="app" id="app">
        <div class="app-txt">
          <div class="ana-top">
            <span class="lab">/app · concept</span>
            <div class="k-seg" role="group" aria-label="Lingua del sito / Site language"><button type="button" data-ana-lang="it" aria-pressed="true">IT</button><button type="button" data-ana-lang="en" aria-pressed="false">EN</button></div>
          </div>
          <svg class="icon" viewBox="0 0 100 100" role="img" aria-label="KERN app icon">
            <rect width="100" height="100" rx="23" fill="#0F140E" />
            <g stroke="#E8E6DA"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" fill="#E8E6DA" stroke="none" transform="translate(-5 -5)"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" transform="translate(5 5)"/><circle cx="66.4" cy="66.4" r="9" fill="#C9F24A" stroke="none"/></g>
          </svg>
          <h2 class="k-h">kern<span>.</span><sup style="font-size:.28em;letter-spacing:0;margin-left:.15em;vertical-align:super;opacity:.7">™</sup></h2>
          <p class="lead"><Bi it="Scopri cosa vuoi fare provandolo, non immaginandolo." en="Find out what you want to do by trying it, not imagining it." /></p>
          <ul class="k-tags" aria-label="In breve">
            <li><Bi it="Lavoro vero" en="Real work" /></li>
            <li><Bi it="Nessun cronometro" en="No timers" /></li>
            <li><Bi it="Vince chi lo fa meglio" en="Best work wins" /></li>
            <li><Bi it="AI che fa domande" en="AI that asks questions" /></li>
          </ul>
          <dl class="spec">
            <div><dt><Bi it="Piattaforme" en="Platforms" /></dt><dd>iOS · Android · Web app</dd></div>
            <div><dt><Bi it="Stato" en="Status" /></dt><dd><Bi it="Concept, in sviluppo" en="Concept, in development" /></dd></div>
            <div><dt><Bi it="Per chi" en="For" /></dt><dd><Bi it="Dai 18 ai 35 anni" en="Ages 18 to 35" /></dd></div>
          </dl>
        </div>

        <div class="k-wrap">
          <div class="k-ctl">
            <div class="k-seg" role="group" aria-label="Lingua"><button type="button" data-k-lang="en" aria-pressed="true">EN</button><button type="button" data-k-lang="it" aria-pressed="false">IT</button></div>
            <div class="k-seg" role="group" aria-label="Tema"><button type="button" data-k-theme="dark" aria-pressed="true">Dark</button><button type="button" data-k-theme="light" aria-pressed="false">Light</button></div>
          </div>
          <div class="phone" aria-label="Anteprima interattiva dell'app KERN">
            <div class="k-scr" id="kScr">
              <div class="k-load" id="kLoad" aria-hidden="true">
                <svg viewBox="0 0 100 100"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" class="ks" fill="currentColor"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" class="kl" stroke="currentColor"/><circle cx="66.4" cy="66.4" r="9" class="kc"/></svg>
                <div class="k-word">kern<i>.</i></div>
                <div class="k-tag"><span>Follow the trail.</span><strong>Find your<b>KERN</b>.</strong></div>
              </div>
              <div class="k-sheet" id="kSheet" role="dialog" aria-modal="true" aria-labelledby="kShT" hidden>
                <div class="k-sh-in">
                  <div class="k-grab" aria-hidden="true"></div>
                  <div class="k-l" id="kShL">Mission 002 · startup partner</div>
                  <h5 id="kShT">Fix what already exists</h5>
                  <p class="k-msg k-ai" id="kShQ">What would make the first step easier for someone brand new?</p>
                  <label class="k-l" for="kTa">Your answer</label>
                  <textarea id="kTa" rows="4"></textarea>
                  <div class="k-sh-btns"><button type="button" class="k-go" id="kSub">Submit answer</button><button type="button" class="k-sk" id="kCancel">Not now</button></div>
                </div>
              </div>
              <div class="k-reward" id="kReward" role="dialog" aria-modal="true" aria-labelledby="kRwT" hidden>
                <div class="k-conf" id="kConf" aria-hidden="true"></div>
                <div class="k-rw-in">
                  <div class="k-medal" aria-hidden="true">#1</div>
                  <div class="k-l">Voted first</div>
                  <h4 id="kRwT">Your answer<br>won <b>#1.</b></h4>
                  <p>Anonymous reviewers ranked it first out of 128.</p>
                  <div class="k-gain"><b id="kGain">+0</b> <span class="k-l">stones</span></div>
                  <div class="k-rankup" id="kRU" hidden><div class="k-l">New rank</div><div class="k-rank" id="kRU2"></div></div>
                  <button type="button" class="k-go" id="kRwOk">Keep going</button>
                </div>
              </div>
              <div class="k-start on" id="kLogin">
                <div class="k-sp">
                  <div class="k-l" id="kLlab">Welcome back</div>
                  <h4 id="kLh">Log in to<br>your <b>trail.</b></h4>
                  <div class="k-field" id="kNm" hidden><label class="k-l" for="kNmI">Name</label><input id="kNmI" type="text" value="Alex Demo" readonly /></div>
                  <div class="k-field"><label class="k-l" for="kEm">Email</label><input id="kEm" type="email" value="alex@example.com" readonly /></div>
                  <div class="k-field"><label class="k-l" for="kPw">Password</label><input id="kPw" type="password" value="demo-password" readonly /></div>
                  <button type="button" class="k-go" id="kLog">Log in</button>
                  <button type="button" class="k-sk" id="kSw">Create an account</button>
                  <div class="k-l">Demo account · nothing is sent or saved</div>
                </div>
              </div>
              <div class="k-start" id="kStart">
                <div id="kS1" class="k-sp">
                  <svg class="k-cairn" viewBox="0 0 120 96" aria-hidden="true"><ellipse class="c3" cx="60" cy="82" rx="46" ry="12"/><ellipse class="c2" cx="60" cy="58" rx="34" ry="11"/><ellipse class="c1" cx="60" cy="36" rx="22" ry="9"/><circle class="cd" cx="60" cy="16" r="7"/></svg>
                  <div class="k-l">Start here</div>
                  <h4>What do you want<br>to <b>do?</b></h4>
                  <button type="button" class="k-go" id="kIdk">I don't know what I want to do</button>
                  <button type="button" class="k-sk" id="kSkip">Explore missions</button>
                </div>
                <div id="kS2" class="k-sp" hidden>
                  <div class="k-l">Good. Let's find out.</div>
                  <h4>What are you<br>curious about <b>right now?</b></h4>
                  <div class="k-chips" id="kPick"><span role="button" tabindex="0">Design</span><span role="button" tabindex="0">Writing</span><span role="button" tabindex="0">Code</span><span role="button" tabindex="0">Video</span><span role="button" tabindex="0">Selling</span><span role="button" tabindex="0">Music</span></div>
                  <button type="button" class="k-go" id="kGo">Start my first mission</button>
                </div>
              </div>
              <div class="k-app">
                <div class="k-top">
                  <div class="k-logo"><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M23.13 76.87A38 38 0 0 1 76.87 23.13Z" fill="currentColor" transform="translate(-5 -5)"/><path d="M23.13 76.87A38 38 0 0 0 76.87 23.13Z" fill="none" stroke-width="7" stroke-linejoin="round" stroke="currentColor" transform="translate(5 5)"/><circle cx="66.4" cy="66.4" r="9"/></svg>kern<i>.</i></div>
                  <div class="k-tp"><span class="k-pill">1 of 3 done</span><button type="button" class="k-av" id="kAv" aria-label="Log out (demo account)">A</button></div>
                </div>
                <div class="k-body">
                  <div class="k-pane on" id="k-missions">
                    <div><div class="k-l">All missions open</div><h4>Pick your<br>next <b>move.</b></h4></div>
                    <div class="k-card k-main" id="kM0"><div class="k-l">Mission 002 · startup partner</div><h5>Fix what already exists</h5><p>Make a real startup's onboarding screen clearer. The opposite of starting from a blank page.</p><div class="k-l">128 answers · judged on quality</div><button type="button" class="k-btn" id="kAdd">Add your answer</button></div>
                    <div class="k-card k-aic"><div class="k-l">Co-pilot · asks, never answers</div><p class="k-msg k-me" id="kIdea">Your idea: a 3-step onboarding with one clear choice at the start.</p><p class="k-msg k-ai" id="kAi">What would make the first step easier for someone brand new?</p><button type="button" class="k-ask-btn" id="kAsk">Another question</button></div>
                    <div class="k-card k-best"><div class="k-l k-live">Mission of the week · best answers</div><div class="k-done"><span>Answer #7</span><small>4.6 / 5</small></div><div class="k-done"><span>Answer #31</span><small>4.4 / 5</small></div><div class="k-done"><span>Answer #12</span><small>4.3 / 5</small></div><p>Ranked by anonymous review, not likes.</p><button type="button" class="k-win" id="kWin">See what a win feels like</button></div>
                    <div class="k-card" id="kM1"><div class="k-l">Mission 003 · KERN</div><h5>Rewrite a confusing email</h5><p>Do it your way. Every answer counts.</p><div class="k-l">54 answers</div></div>
                    <div class="k-card" id="kM2"><div class="k-l">Mission 004 · studio client</div><h5>Work with a partner</h5><p>Answer together with someone else.</p><div class="k-l">31 answers</div></div>
                  </div>
                  <div class="k-pane" id="k-yourkern">
                    <div><div class="k-l">yourKERN · first signs</div><h4>Your <b>KERN</b><br>so far.</h4></div>
                    <div class="k-card k-lvl"><div class="k-lvl-top"><div><div class="k-l">Your rank</div><div class="k-rank" id="kRank">Stone</div></div><div class="k-stones"><b id="kSt">240</b> <span class="k-l">stones</span></div></div><div class="k-bar k-bar-g"><i id="kBar"></i></div><small class="k-nx" id="kNx"></small><div class="k-ladder" id="kLad"></div></div>
                    <div class="k-card"><div class="k-l">This week's circle</div><div id="kCircle"></div><div class="k-l">No one drops more than one rank in a week.</div></div>
                    <div class="k-duo"><div class="k-card"><div class="k-l">Time on KERN missions</div><div class="k-stat"><b>1h 15m</b><span class="k-l">this week · only you see this</span></div><div class="k-bar"><i></i></div></div><div class="k-card"><div class="k-l">Your rhythm · no pressure</div><div class="k-dots"><i class="f"></i><i class="f"></i><i class="f"></i><i></i></div><p>3 weeks this month you made something.</p></div></div>
                    <div class="k-card"><div class="k-l">What you seem drawn to</div><div class="k-chips"><span>Shaping ideas</span><span>Writing</span><span>Solo work</span></div></div>
                    <div class="k-card"><div class="k-l">How you work with AI</div><div class="k-sig">You rewrote your question 4 times, and every version got clearer.</div></div>
                    <div class="k-card"><div class="k-l">A first guess</div><div class="k-sig">You seemed to light up on the open brief and drag on the polish.</div><div class="k-l">Why we think so: you tried 3 versions of the open brief, and you wrote "time flew".</div>
                      <div class="k-ask"><button type="button" class="k-yes" data-k-msg="Saved. This sharpens your KERN.">That feels right</button><button type="button" data-k-msg="Noted. We'll give this guess less weight.">Not really</button></div><div class="k-l k-fb" id="kFb" aria-live="polite"></div></div>
                    <div><div class="k-l">Completed</div><div class="k-done"><span>Make somebody care</span><small>MISSION 001</small></div></div>
                    <div class="k-card"><div class="k-l">Worth trying next</div><h5>Improve an existing product page</h5><p>Tests the part you seemed to drag on.</p></div>
                  </div>
                  <div class="k-pane" id="k-trail">
                    <div><div class="k-l">Your Trail</div><h4>Follow the<br><b>trail.</b></h4></div>
                    <div class="k-tr">
                      <div class="k-st fin"><h5>Make somebody care</h5><p>Build from zero · done</p></div>
                      <div class="k-st now"><h5 id="kTrNow">Fix what already exists</h5><p>In progress</p></div>
                      <div class="k-st"><h5 id="kTrNext">Work with a partner</h5><p>Pair up · not started</p></div>
                      <div class="k-st"><h5>Your Kern card</h5><p>What we saw, why, and your next move</p></div>
                    </div>
                    <div class="k-card"><div class="k-l">Leave a sign</div><p>After each mission, leave one short tip for the next person.</p></div>
                    <div class="k-card"><div class="k-l">Your Kern card · preview</div><div class="k-kc"><div class="k-kt">kern<i>.</i></div><h5>You light up when you start from zero.</h5><div class="k-chips"><span>Shaping ideas</span><span>Writing</span></div><div class="k-l">3 missions · first guess</div></div><button type="button" class="k-ask-btn" data-k-toast="Card ready to share. Your friends see what you made, not a test result.">Share my card</button></div>
                    <div class="k-card"><div class="k-l">Dare a friend</div><p>Send a mission. You both answer, then see the two answers side by side.</p><button type="button" class="k-ask-btn" data-k-toast="Link copied. Your friend answers the same mission.">Send a dare</button></div>
                  </div>
                  <div class="k-pane" id="k-copilot">
                    <div><div class="k-l">KERN.AI ·your co-pilot</div><h4>Your idea.<br>My <b>questions.</b></h4></div>
                    <div class="k-ait"><span class="k-dot" aria-hidden="true"></span><div class="k-l">You are talking to an AI · replies are a scripted preview</div></div>
                    <div class="k-card k-chat">
                      <div class="k-log" id="kChat" aria-live="polite"></div>
                      <div class="k-cmp" id="kCmp" hidden><div class="k-l">Version 1</div><p id="kV1"></p><div class="k-l">Version 3</div><p id="kV3"></p><button type="button" class="k-ask-btn" data-k-toast="Saved to yourKERN. Every version counts as evidence.">Save to yourKERN</button></div>
                      <div class="k-comp"><input id="kIn" type="text" maxlength="140" autocomplete="off" aria-label="Your idea" /><button type="button" class="k-send" id="kSend" aria-label="Send">↑</button></div>
                      <div class="k-chips" id="kEx"><span role="button" tabindex="0">Use an example</span><span role="button" tabindex="0">Start over</span></div>
                    </div>
                    <div class="k-card"><div class="k-l">Do it twice</div><p>Make it alone first. Then with the co-pilot. Compare the two.</p></div>
                    <div class="k-card"><div class="k-l">The rules</div><p>It asks. It never answers.</p><p>Your idea always comes first.</p><p>If it gets heavy, it stops and points you to a person.</p></div>
                  </div>
                </div>
                <div class="k-toast" id="kToast" role="status" aria-live="polite"></div>
                <nav class="k-tabs" aria-label="KERN">
                  <button type="button" class="on" data-k-tab="missions">Missions</button>
                  <button type="button" data-k-tab="yourkern"><b class="tl">your<span>KERN</span></b></button>
                  <button type="button" data-k-tab="trail">Trail</button>
                  <button type="button" data-k-tab="copilot">KERN.AI</button>
                </nav>
              </div>
            </div>
          </div>
          <button type="button" class="k-replay" id="kReplay">↻ Rivedi l'apertura</button>
        </div>
      </section>

      <section class="why" id="perche">
        <span class="lab"><Bi it="/perché" en="/why" /></span>
        <h2><Bi it="Chi non sa cosa vuole non trova una porta d'ingresso." en="If you don't know what you want, there's no way in." /></h2>
        <p class="lead"><Bi it="Giovani incerti, aziende che chiedono prove, sempre meno posti d'ingresso." en="Unsure young people, employers asking for proof, fewer entry-level roles." /></p>
        <div class="charts">
          {kstats.map((s) => (
            <figure class="chart">
              <figcaption><Bi it={s.t.it} en={s.t.en} /></figcaption>
              {[s.a, s.b].map((r, k) => (
                <div class="row">
                  <span><Bi it={r.l.it} en={r.l.en} /></span>
                  <b><Bi it={r.r.it} en={r.r.en} /></b>
                  <div class="track"><i class={k ? 'y' : 'w'} style={`--v:${Math.max((r.v / s.max) * 100, 1.5)}%`}></i></div>
                </div>
              ))}
            </figure>
          ))}
        </div>
        <p class="note"><Bi it='Dati di ricerca generali, non risultati di KERN; barre indicative, alcune cifre da fonti secondarie. Fonti: NACE Job Outlook 2026 · Tallo / Forbes 2025 · Big Brothers Big Sisters / Harris Poll 2025 · Harvard Business School e Burning Glass Institute · NPR e IBISWorld 2026. <a href="#fonti">Dettagli</a>' en='General research, not KERN results; bars are indicative and some figures come from secondary sources. Sources: NACE Job Outlook 2026 · Tallo / Forbes 2025 · Big Brothers Big Sisters / Harris Poll 2025 · Harvard Business School &amp; Burning Glass Institute · NPR &amp; IBISWorld 2026. <a href="#fonti">Details</a>' /></p>
        <div class="duo">
          <div><span class="lab"><Bi it="La differenza" en="The difference" /></span><p><Bi it="Gli altri partono da un ruolo. KERN parte da te." en="Others start from a role. KERN starts from you." /></p></div>
          <div><span class="lab"><Bi it="L'obiettivo" en="The goal" /></span><p><Bi it="Aiutarti a capire cosa vuoi, con lavoro vero." en="Help you work out what you want, through real work." /></p></div>
        </div>
      </section>


      <section class="top">
        <span class="lab">/web</span>
        <h1>Nuovo link.</h1>
        <p class="lead">Tre siti da aprire e toccare con mano. Un click e sei dentro.</p>
      </section>

      <section class="demos" aria-label="Demo">
        {demos.map((d, i) => (
          <article class="card">
            <div class="shot">
              <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{d.slug === 'hair' ? 'sezione.it' : d.slug === 'innesto' ? 'innesto.it' : 'bracemilano.it'}</span></div>
              <div class="view" data-shot>
                <img class="poster" src={`/previews/${d.slug}.webp`} width="960" height="600" alt="" loading="lazy" decoding="async" />
                <iframe data-src={`/demo/${d.slug}/index.html`} title={`Anteprima ${d.name}`} scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
                <a class="cover" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener" aria-label={`Apri la demo ${d.name}`}><span>Apri la demo →</span></a>
              </div>
            </div>
            <div class="meta">
              <span class="lab">0{i + 1} · {d.kind}</span>
              <h3>{d.name}</h3>
              <p>{d.line}</p>
              <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
              <div class="next">
                <span class="lab">Prossime modifiche</span>
                <ul>{d.next.map((n) => <li>{n}</li>)}</ul>
              </div>
