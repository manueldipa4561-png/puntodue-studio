      .k-replay:hover { border-color: var(--yellow); color: var(--yellow); }
      .k-scr.light { --bg: #E8E6DA; --fg: #141A12; --acc: #2C5A3A; --on: #E8E6DA; --line: #B9B7A8; --dim: #5b6156; }
      .k-scr { --bg: #0F140E; --fg: #E8E6DA; --acc: #C9F24A; --on: #0F140E; --line: #2a3128; --dim: #9a9d8e; position: relative; height: 600px; border-radius: 34px; overflow: hidden; background: var(--bg); color: var(--fg); }
      .k-scr h4, .k-scr h5, .k-scr p { margin: 0; }
