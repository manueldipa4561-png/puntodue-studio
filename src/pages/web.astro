---
import Site from '../layouts/Site.astro';
import Sim from '../components/Sim.astro';
import Chat from '../components/Chat.astro';
import Bi from '../components/Bi.astro';
const WA = `https://wa.me/393248423657?text=${encodeURIComponent('Ciao! Ho visto le vostre demo e vorrei parlarvi di un progetto.')}`;
const demos = [
  { slug: 'hair', name: 'SEZIONE', kind: 'Hair studio', line: 'Il sito di un salone, per lei e per lui.', tags: ['Lei / Lui', 'WebGL', 'Tessera + QR'], next: ['Prenotazione con conferma su WhatsApp', 'Timbri aggiunti dallo staff scansionando il QR', 'Tessera salvabile nel Wallet del telefono', 'Promemoria su WhatsApp prima della visita'] },
  { slug: 'innesto', name: 'INNESTO', kind: 'Ristrutturazioni', line: 'Ristrutturazioni chiavi in mano: casa 3D, prima/dopo e stima in 4 domande.', tags: ['Casa 3D', 'Prima / Dopo', '3 pagine'], next: ['Preventivo guidato in 4 domande', 'Area cliente con avanzamento del cantiere', 'Coupon sopralluogo gratuito a tempo', 'Sconto referral per chi consiglia lo studio'] },
  { slug: 'brace', name: 'BRACE', kind: 'Smokehouse e vini naturali', line: 'Brisket affumicato 14 ore, vini naturali e tavolo prenotato con conferma su WhatsApp.', tags: ['Fumo in WebGL', 'Timeline 14 ore', 'Tessera + QR'], next: ['Acconto online per tenere da parte il brisket', 'Tessera con QR: alla 6ª cena il brisket è offerto', 'Coupon a tempo per riempire martedì e mercoledì', 'Porta un amico: un calice offerto a entrambi'] },
];
const stats = [
  { t: 'Probabilità di vendere', a: { l: 'Nuovo contatto', v: 12.5, r: '5–20%' }, b: { l: 'Cliente già acquisito', v: 65, r: '60–70%' }, max: 100 },
  { t: 'Costo per ottenere un cliente', a: { l: 'Mantenerne uno', v: 1, r: '1×' }, b: { l: 'Trovarne uno nuovo', v: 15, r: '5–25×' }, max: 25 },
  { t: 'Profitto con +5% di clienti fedeli', a: { l: 'Oggi', v: 0, r: '—' }, b: { l: 'Con +5% di retention', v: 60, r: '+25–95%' }, max: 100 },
];
const feats = [
  { id: 'sito', t: 'Sito veloce', d: 'Più contatti ogni mese', n: 0.15, r: 0 },
  { id: 'fed', t: 'Tessera fedeltà', d: 'I clienti tornano più spesso', n: 0, r: 0.12 },
  { id: 'cp', t: 'Coupon', d: 'Riporta chi si era perso', n: 0.1, r: 0.05 },
  { id: 'wa', t: 'Promemoria WhatsApp', d: 'Meno appuntamenti saltati', n: 0, r: 0.06 },
  { id: 'ref', t: 'Referral', d: 'I clienti portano amici', n: 0.2, r: 0.02 },
];
// slashkern (/app): le 7 categorie e i progetti di prova come sono nell'app (clienti fittizi, scritto anche nella pagina)
const SK = [
  { f: 'video', it: 'Video brevi', en: 'Short videos',
    t: { it: 'Storyboard di 15 secondi per un furgone di panini', en: '15-second storyboard for a sandwich van' },
    b: { it: 'Scegli poche cose e alla fine hai uno storyboard di quattro vignette che Rocco può girare con il telefono.', en: 'Pick a few things and end with a four-frame storyboard that Rocco can film on his phone.' },
    c: { it: 'Il furgone di panini di Rocco (fittizio)', en: 'Rocco’s sandwich van (fictional)' } },
  { f: 'design', it: 'Poster e loghi', en: 'Posters and logos',
    t: { it: 'Scheda del brand per un bar', en: 'Brand sheet for a bar' },
    b: { it: 'Scegli poche cose e alla fine hai una pagina che mostra com’è e cosa trasmette un bar.', en: 'Pick a few things and end with a page that shows how a bar looks and feels.' },
    c: { it: 'Bar Ficus (fittizio)', en: 'Bar Ficus (fictional)' } },
  { f: 'writing', it: 'Post e didascalie', en: 'Posts and captions',
    t: { it: 'Kit di lancio per un gusto nuovo', en: 'Launch kit for a new flavour' },
    b: { it: 'Dai un nome a un gusto nuovo, scrivi il cartello per il banco e il primo post: alla fine hai una pagina da mostrare.', en: 'Name a new flavour, write the sign for the counter and the first post, and end with one page you can show.' },
    c: { it: 'Pigro Gelato (fittizio)', en: 'Pigro Gelato (fictional)' } },
  { f: 'code', it: 'Siti e piccoli strumenti', en: 'Websites and small tools',
    t: { it: 'Sito di una pagina per un negozio di piante', en: 'One-page website for a plant shop' },
    b: { it: 'Scegli poche cose e alla fine hai una vera pagina web, in un file che puoi aprire e mettere online.', en: 'Pick a few things and end with a real web page, as a file you can open and put online.' },
    c: { it: 'Sunny Plants, un negozio di piante (fittizio)', en: 'Sunny Plants, a plant shop (fictional)' } },
  { f: 'selling', it: 'Annunci di prodotti', en: 'Product listings',
    t: { it: 'Annuncio per una lampada da scrivania usata', en: 'Listing for a used desk lamp' },
    b: { it: 'Scegli cosa dire e scrivi due righe brevi. Alla fine hai un annuncio onesto per una lampada usata.', en: 'Pick what to say and write two short lines. You end with an honest listing for a used lamp.' },
    c: { it: 'Marta (fittizia)', en: 'Marta (fictional)' } },
  { f: 'music', it: 'Musica e suoni', en: 'Music and sound',
    t: { it: 'Un ritmo e la sua scheda di uscita', en: 'A beat and its release card' },
    b: { it: 'Batti un ritmo, dagli un nome e scegli la sua cover. Alla fine hai una scheda che suona il tuo ritmo.', en: 'Tap a beat, name it and pick its cover. End with a release card that plays your beat.' },
    c: { it: 'Clank Gym (fittizia)', en: 'Clank Gym (fictional)' } },
  { f: 'prompting', it: 'Prompt per l’AI', en: 'AI prompts',
    t: { it: 'Un prompt che scrive un post', en: 'A prompt that writes a post' },
    b: { it: 'Costruisci un prompt con poche scelte, mandalo all’AI e tieni il post che scrive, segnato come AI.', en: 'Build a prompt from a few choices, send it to the AI and keep the post it writes, marked as AI.' },
    c: { it: 'il corso di ceramica di Dana (fittizio)', en: 'Dana’s pottery class (fictional)' } },
];
// i gradi della KernCard e le pietre che servono per ognuno (come nell'app)
const RANKS = [
  { it: 'Ciottolo', en: 'Pebble', s: 0 }, { it: 'Pietra', en: 'Stone', s: 100 }, { it: 'Cairn', en: 'Cairn', s: 300 },
  { it: 'Cresta', en: 'Ridge', s: 700 }, { it: 'Vetta', en: 'Summit', s: 1500 },
];
// il primo passo vero del progetto Video: Slash chiede il gancio
const HOOKS = [
  { it: 'Formaggio che fila al rallentatore', en: 'Cheese pull in slow motion' },
  { it: 'Rocco che grida l’ordine', en: 'Rocco shouting the order' },
  { it: 'Un coltello che taglia il pane', en: 'A knife slicing the bread' },
];
// il simbolo di slashkern (è anche Slash): corpo e occhi, i colori li dà il CSS
const MARK = '<path d="M99.56 84.12Q92.48 78.56 92.48 87.56L92.48 293.52Q92.48 311.52 107.50 301.60L157.49 268.57Q164.16 264.16 167.68 271.34L190.00 316.87Q196.16 329.44 209.09 324.08L235.71 313.04Q248.64 307.68 241.86 295.43L219.23 254.52Q215.36 247.52 223.36 247.52L289.52 247.52Q307.52 247.52 293.37 236.40Z"/><path class="eye" d="M113.73 226.02Q108.63 210.34 124.32 205.25L124.34 205.24Q140.02 200.14 145.11 215.83L151.61 235.82Q156.71 251.50 141.02 256.60L141.00 256.60Q125.32 261.70 120.22 246.02ZM167.15 200.06Q162.06 184.38 177.74 179.28L177.76 179.27Q193.44 174.18 198.54 189.86L205.03 209.85Q210.13 225.53 194.45 230.63L194.43 230.64Q178.74 235.73 173.65 220.05Z"/>';
// nel nome resta un po' di spazio tra r e n, così "rn" non si legge "m" (regola del brand)
const WORD = 'slashke<span class="rn">r</span>n';
---
<Site title="Siti web e app: lavori e demo — Punto Due Studio" description="Tre demo di siti complete e cliccabili, più slashkern, un'app in accesso anticipato: progetti brevi da finire con un assistente AI e tenere sulla propria pagina." active="web">
      <section class="app" id="app">
        <div class="app-txt">
          <div class="ana-top">
            <span class="lab">/app · <Bi it="accesso anticipato" en="early access" /></span>
            <div class="k-seg" role="group" aria-label="Lingua del sito / Site language"><button type="button" data-ana-lang="it" aria-pressed="true">IT</button><button type="button" data-ana-lang="en" aria-pressed="false">EN</button></div>
          </div>
          <svg class="icon" viewBox="0 0 400 400" role="img" aria-label="slashkern app icon">
            <rect width="400" height="400" rx="92" fill="#0050F0" />
            <g transform="translate(200 200) scale(0.86) translate(-196.03 -203.84)"><g fill="#fff" stroke="#fff" stroke-width="18" stroke-linejoin="round" set:html={MARK} /><g class="sk-mk" set:html={MARK} /></g>
          </svg>
          <h2 class="k-h" set:html={WORD} />
          <p class="k-slogan"><Bi it="Da zero al prodotto." en="From zero to product." /></p>
          <p class="lead"><Bi it="Scegli un progetto breve, finiscilo con Slash, il tuo assistente AI, e tienilo sulla tua pagina." en="Pick a short project, finish it with Slash, your AI assistant, and keep it on your own page." /></p>
          <ul class="k-tags" aria-label="In breve">
            <li><Bi it="Gratis per i creator" en="Free for creators" /></li>
            <li><Bi it="7 categorie" en="7 categories" /></li>
            <li><Bi it="Slash ti aiuta. Tu finisci." en="Slash helps. You finish." /></li>
            <li><Bi it="La tua KernCard" en="Your KernCard" /></li>
          </ul>
          <dl class="spec">
            <div><dt><Bi it="Piattaforma" en="Platform" /></dt><dd><Bi it="Web app installabile" en="Installable web app" /></dd></div>
            <div><dt><Bi it="Stato" en="Status" /></dt><dd><Bi it="Accesso anticipato · lista d'attesa" en="Early access · waitlist" /></dd></div>
            <div><dt><Bi it="Per chi" en="For" /></dt><dd><Bi it="Dai 18 anni, in Europa" en="18+, across Europe" /></dd></div>
            <div><dt><Bi it="Lingue" en="Languages" /></dt><dd>7</dd></div>
          </dl>
          <p class="note"><Bi it="Un progetto indipendente, separato da Punto Due Studio, e non ancora aperto. Nell'anteprima i clienti sono fittizi e i numeri d'esempio." en="An independent project, separate from Punto Due Studio, and not open yet. In the preview the clients are fictional and the numbers are examples." /> <a class="lnk" href="https://slashkern.com/" target="_blank" rel="noopener">slashkern.com →</a></p>
        </div>

        <div class="k-wrap">
          <div class="phone" role="group" aria-label="L'app slashkern: schermata di apertura">
            <div class="sk" id="sk">
              <div class="sk-load" id="skLoad" aria-hidden="true">
                <svg class="sk-fly sk-mk" viewBox="82 69 235 271" set:html={MARK} />
                <div class="sk-word" set:html={WORD} />
                <div class="sk-tag"><Bi it="Da zero al prodotto." en="From zero to product." /></div>
              </div>
              <div class="sk-top"><div class="sk-logo"><svg class="sk-mk" viewBox="82 69 235 271" aria-hidden="true" set:html={MARK} /><span set:html={WORD} /></div><span class="sk-av" aria-hidden="true">G</span></div>
              <div class="sk-body" id="skBody">
                <div class="sk-pane on" id="sk-projects">
                  <p class="sk-hi"><Bi it="Ciao Giulia" en="Hi Giulia" /></p>
                  <div class="sk-row"><span class="sk-l"><Bi it="Il tuo percorso" en="Your path" /></span><button type="button" class="sk-more" id="skMore" aria-expanded="false" aria-controls="skPaths"><Bi it="Altri percorsi" en="More paths" /> <i aria-hidden="true">▾</i></button></div>
                  <div class="sk-paths" id="skPaths" hidden>
                    {SK.map((c, i) => <button type="button" class="sk-path" data-f={c.f} aria-pressed={i === 0 ? 'true' : 'false'}><img src={`/kern/sk-${c.f}.webp`} alt="" width="96" height="96" loading="lazy" decoding="async" /><Bi it={c.it} en={c.en} /></button>)}
                  </div>
                  <h3 class="sk-field" id="skField"><Bi it={SK[0].it} en={SK[0].en} /></h3>
                  {SK.map((c, i) => (
                    <article class="sk-piece" data-f={c.f} hidden={i !== 0}>
                      <img class="sk-obj" src={`/kern/sk-${c.f}.webp`} alt="" width="96" height="96" loading="lazy" decoding="async" />
                      <span class="sk-l"><Bi it="Un pezzo per la tua pagina" en="A piece for your page" /></span>
                      <h4><Bi it={c.t.it} en={c.t.en} /></h4>
                      <p><Bi it={c.b.it} en={c.b.en} /></p>
                      <span class="sk-l"><Bi it="5 piccoli passi" en="5 small steps" /> · <Bi it={c.c.it} en={c.c.en} /></span>
                      <button type="button" class="sk-start" data-start><Bi it="Inizia" en="Start" /></button>
                    </article>
                  ))}
                  <p class="sk-s"><Bi it="Ogni pagina finita dice «Progetto di prova» e il nome del cliente fittizio." en="Every finished page says “Practice project” and names the fictional client." /></p>
                </div>

                <div class="sk-pane" id="sk-kerncard">
                  <div><span class="sk-l">KernCard</span><h3><Bi it="La tua KernCard." en="Your KernCard." /></h3><p class="sk-s"><Bi it="Tutto quello che finisci sta su una pagina, la tua KernCard. Le aziende vedono solo quello che pubblichi." en="Everything you finish lives on one page, your KernCard. Companies see only what you publish." /></p></div>
                  <div class="sk-stage" id="skStage">
                    <div class="sk-card" id="skCard">
                      <div class="sk-face sk-front">
                        <i class="sk-foil" aria-hidden="true"></i>
                        <div class="sk-ct"><span class="sk-kt"><svg class="sk-mk" viewBox="82 69 235 271" aria-hidden="true" set:html={MARK} /><span set:html={WORD} /></span><span class="sk-l sk-cf"><Bi it={SK[0].it} en={SK[0].en} /></span></div>
                        <div class="sk-bar" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
                        <span class="sk-l"><Bi it='<b class="sk-n">0</b> su 6 progetti' en='<b class="sk-n">0</b> of 6 projects' /></span>
                        <p class="sk-q" id="skQ"><Bi it="Il primo progetto che finisci comparirà qui." en="The first project you finish shows up here." /></p>
                        <span class="sk-l sk-ex"><Bi it="Carta d'esempio · anteprima" en="Example card · preview" /></span>
                      </div>
                      <div class="sk-face sk-back" aria-hidden="true">
                        <i class="sk-foil" aria-hidden="true"></i>
                        <div class="sk-ct"><span class="sk-kt"><svg class="sk-mk" viewBox="82 69 235 271" aria-hidden="true" set:html={MARK} /><span set:html={WORD} /></span><span class="sk-l sk-cf"><Bi it={SK[0].it} en={SK[0].en} /></span></div>
                        <span class="sk-l"><Bi it="I tuoi progetti" en="Your projects" /></span>
                        <ul class="sk-list" id="skList"><li class="sk-none"><Bi it="Ancora nessuno." en="None yet." /></li></ul>
                        <div class="sk-rank"><div><span class="sk-l"><Bi it="Il tuo grado" en="Your rank" /></span><b>{RANKS.map((r, i) => <span class="sk-rn" hidden={i !== 0}><Bi it={r.it} en={r.en} /></span>)}</b></div><div class="sk-stn"><b id="skSt">0</b> <span class="sk-l"><Bi it="pietre" en="stones" /></span></div></div>
                        <p class="sk-foot"><Bi it="Da zero al prodotto." en="From zero to product." /></p>
                      </div>
                    </div>
                  </div>
                  <button type="button" class="sk-flip" id="skFlip" aria-pressed="false"><span aria-hidden="true">↻</span> <Bi it="Gira la carta" en="Flip the card" /></button>
                  <div class="sk-ladder" id="skLad">{RANKS.map((r) => <span data-s={r.s}><Bi it={r.it} en={r.en} /><small>{r.s}</small></span>)}</div>
                  <p class="sk-early"><Bi it="Accesso anticipato: le aziende non sono ancora su slashkern." en="Early access: companies are not on slashkern yet." /></p>
                </div>

                <div class="sk-pane" id="sk-slash">
                  <div class="sk-sh"><svg class="sk-slash sk-mk" viewBox="82 69 235 271" aria-hidden="true" set:html={MARK} /><div><span class="sk-l">Slash</span><h3><Bi it="Slash ti aiuta.<br>Tu finisci." en="Slash helps.<br>You finish." /></h3></div></div>
                  <div class="sk-chat" id="skChat" aria-live="polite">
                    <span class="sk-l"><Bi it="Anteprima: risposte già scritte, non un'AI dal vivo. Nell'app Slash è un'AI." en="Preview: scripted replies, not a live AI. In the app, Slash is an AI." /></span>
                    <p class="sk-msg sk-ai"><Bi it="Scegli il gancio: cosa mostrano i primi 2 secondi?" en="Pick the hook: what do the first 2 seconds show?" /></p>
                    <div class="sk-chips" data-s="0">{HOOKS.map((h) => <button type="button" class="sk-chip"><Bi it={h.it} en={h.en} /></button>)}</div>
                    <p class="sk-msg sk-me" data-s="1" hidden></p>
                    <p class="sk-msg sk-ai" data-s="1" hidden><Bi it="Chiaro. Manca una cosa: cosa dice a chi guarda l'ultima vignetta?" en="Clear. One thing is missing: what does the last frame tell people?" /></p>
                    <button type="button" class="sk-start sk-draft" data-s="1" hidden><Bi it="Prepara una prima versione" en="Draft a first version" /></button>
                    <div class="sk-msg sk-ai" data-s="2" hidden><Bi it="Ultima vignetta: il furgone e la scritta «Aperti oggi, dalle 12 alle 15»." en="Last frame: the van, and “Open today, 12 to 3” on screen." /><span class="sk-aitag"><Bi it="Creato con l’aiuto dell’AI" en="Made with AI help" /></span></div>
                    <p class="sk-msg sk-ai" data-s="2" hidden><Bi it="È solo una bozza: decidi tu cosa tenere." en="It is only a draft: you decide what stays." /></p>
                    <button type="button" class="sk-again" id="skAgain" data-s="2" hidden><Bi it="Ricomincia" en="Start over" /></button>
                  </div>
                  <div class="sk-rules">
                    <div><span class="sk-l"><Bi it="Slash fa" en="Slash does" /></span><ul><li><Bi it="Fa una domanda alla volta." en="Asks one question at a time." /></li><li><Bi it="Ti dice cosa non è chiaro o cosa manca." en="Points at what is unclear or missing." /></li><li><Bi it="Prepara una prima versione se glielo chiedi, segnata «Creato con l’aiuto dell’AI»." en="Drafts a first version when you ask, tagged Made with AI help." /></li></ul></div>
                    <div class="no"><span class="sk-l"><Bi it="Slash non" en="Slash does not" /></span><ul><li><Bi it="Pubblica al posto tuo." en="Publish anything for you." /></li><li><Bi it="Sceglie al posto tuo." en="Make your choices." /></li><li><Bi it="Nasconde il suo aiuto." en="Hide its help." /></li></ul></div>
                  </div>
                </div>
              </div>

              <div class="sk-saved" id="skSaved" role="dialog" aria-modal="true" aria-labelledby="skSvT" hidden>
                <div class="sk-sv-in">
                  <span class="sk-ok" aria-hidden="true">✓</span>
                  <span class="sk-l"><Bi it="Anteprima: i cinque passi sono saltati" en="Preview: the five steps are skipped" /></span>
                  <h3 id="skSvT"><Bi it="Salvato nella tua KernCard" en="Saved to your KernCard" /></h3>
                  <p><Bi it="Il progetto è nella tua KernCard. Le aziende non sono ancora su slashkern." en="The project is on your KernCard. Companies are not on slashkern yet." /></p>
                  <button type="button" class="sk-start" id="skSeeCard"><Bi it="Vedi la mia KernCard" en="See my KernCard" /></button>
                  <button type="button" class="sk-again" id="skStay"><Bi it="Resta sui progetti" en="Stay on projects" /></button>
                </div>
              </div>

              <nav class="sk-tabs" aria-label="slashkern">
                <button type="button" class="on" data-sk-tab="projects" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="2"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="2"/></svg><Bi it="Progetti" en="Projects" /></button>
                <button type="button" data-sk-tab="kerncard"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10.5A.5.5 0 0 1 6.5 20V4a.5.5 0 0 1 .5-.5z"/><path d="M9.5 12h5M9.5 15.5h5"/></svg>KernCard</button>
                <button type="button" data-sk-tab="slash"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-8l-4 3.5v-3.5H5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z"/></svg>Slash</button>
              </nav>
            </div>
          </div>
          <button type="button" class="k-replay" id="kReplay"><span aria-hidden="true">↻</span> <Bi it="Rivedi l'apertura" en="Replay the intro" /></button>
        </div>
      </section>


      <section class="top">
        <span class="lab">/web</span>
        <h1>Nuovo link.</h1>
        <p class="lead">Tre siti da aprire e toccare con mano. Un click e sei dentro.</p>
      </section>

      <section class="demos" aria-label="Demo">
        {demos.map((d, i) => (
          <article class="card">
            <div class="shot">
              <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{d.slug === 'hair' ? 'sezione.demo' : d.slug === 'innesto' ? 'innesto.demo' : 'brace.demo'}</span></div>
              <div class="view" data-shot>
                <img class="poster" src={`/previews/${d.slug}.webp`} width="960" height="600" alt={`${d.name}: ${d.line}`} loading="lazy" decoding="async" />
                <iframe data-src={`/demo/${d.slug}/index.html`} title={`Anteprima ${d.name}`} scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
                <a class="cover" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener" aria-label={`Apri la demo ${d.name}`}><span>Apri la demo →</span></a>
              </div>
            </div>
            <div class="meta">
              <span class="lab">0{i + 1} · {d.kind}</span>
              <h2>{d.name}</h2>
              <p>{d.line}</p>
              <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
              <div class="next">
                <span class="lab">Prossime modifiche</span>
                <ul>{d.next.map((n) => <li>{n}</li>)}</ul>
              </div>
              <a class="lnk" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener" aria-label={`Apri la demo ${d.name}`}>Apri la demo →</a>
            </div>
          </article>
        ))}
      </section>
      <section class="why" id="numeri">
        <span class="lab">/numeri</span>
        <h2>Far tornare un cliente vale di più.</h2>
        <p class="lead">Fedeltà e coupon servono a questo. Dati di ricerca generali, non risultati delle demo.</p>
