      .k-stat { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; } .k-stat b { font-weight: 800; font-size: 36px; letter-spacing: -.06em; line-height: 1; }
      .k-bar { height: 6px; border-radius: 6px; background: var(--line); overflow: hidden; } .k-bar i { display: block; height: 100%; width: 62%; background: var(--acc); }
      .k-chips { display: flex; flex-wrap: wrap; gap: 6px; } .k-chips span { border: 1px solid var(--fg); border-radius: 999px; padding: 5px 11px; font-size: 12px; font-weight: 500; }
      .k-sig { border-left: 3px solid var(--acc); padding-left: 12px; font-size: 14px; line-height: 1.4; }
      .k-ask { display: flex; gap: 8px; flex-wrap: wrap; }
      .k-ask button { font-size: 12px; font-weight: 800; border: 1.5px solid var(--fg); background: none; color: var(--fg); border-radius: 999px; padding: 7px 12px; cursor: pointer; }
      .k-ask .k-yes { background: var(--acc); color: var(--on); border-color: var(--acc); }
      .k-fb { min-height: 1.2em; color: var(--acc); }
      .k-done { display: flex; justify-content: space-between; font-size: 14px; padding: 9px 0; border-bottom: 1px solid var(--line); } .k-done small { font: 400 10px var(--mono); color: var(--dim); }
      .k-tr { position: relative; display: flex; flex-direction: column; gap: 18px; padding-left: 32px; }
      .k-tr::before { content: ''; position: absolute; left: 10px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
      .k-st { position: relative; } .k-st::before { content: ''; position: absolute; left: -30px; top: 2px; width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--fg); background: var(--bg); }
      .k-st.fin::before { background: var(--fg); } .k-st.now::before { background: var(--acc); border-color: var(--acc); }
      .k-st h5 { font-weight: 800; font-size: 16px; letter-spacing: -.03em; } .k-st p { font-size: 12px; color: var(--dim); margin-top: 2px; }
      .k-toast { position: absolute; left: 14px; right: 14px; bottom: 72px; background: var(--fg); color: var(--bg); border-radius: 12px; padding: 10px 12px; font-size: 12px; font-weight: 600; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; pointer-events: none; }
      .k-toast.on { opacity: 1; transform: none; }
      .k-tabs { display: flex; border-top: 1px solid var(--line); padding: 6px 8px 12px; }
      .k-tabs button { flex: 1; background: none; border: 0; color: var(--dim); font-weight: 800; font-size: 12px; letter-spacing: -.01em; display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; padding: 6px 0; }
      .k-tabs button::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: transparent; }
      .k-tabs button.on { color: var(--fg); } .k-tabs button.on::before { background: var(--acc); } .k-tabs button.on span { color: var(--acc); }
      /* launch loader (plays once when the phone scrolls into view) */
      .k-load { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; background: var(--bg); transition: opacity .5s; }
      .k-load.off { opacity: 0; pointer-events: none; }
      .k-load svg { width: 92px; overflow: visible; color: var(--fg); }
      .ks, .kl { transform: translate(0,0); } .kl { fill: none; }
      .kc { transform-box: fill-box; transform-origin: center; transform: scale(0); fill: var(--acc); }
      .k-word { font-weight: 800; font-size: 46px; letter-spacing: -.07em; line-height: 1; opacity: 0; transform: translateY(8px); } .k-word i { font-style: normal; color: var(--acc); letter-spacing: 0; }
      .k-tag { position: absolute; bottom: 44px; text-align: center; display: flex; flex-direction: column; gap: 6px; opacity: 0; }
      .k-tag span { font-weight: 500; font-size: 16px; letter-spacing: -.02em; line-height: 1; opacity: .6; }
      .k-tag strong { font-weight: 800; font-size: 27px; letter-spacing: -.06em; line-height: 1; } .k-tag b { color: var(--acc); }
      .k-load.go .ks { animation: kS .9s .35s cubic-bezier(.65,0,.25,1) forwards; }
      .k-load.go .kl { animation: kL .9s .35s cubic-bezier(.65,0,.25,1) forwards; }
      .k-load.go .kc { animation: kC .5s 1.05s cubic-bezier(.3,1.6,.5,1) forwards; }
      .k-load.go .k-word { animation: kR .6s 1.2s cubic-bezier(.2,.8,.2,1) forwards; }
      .k-load.go .k-tag { animation: kR .6s 1.6s cubic-bezier(.2,.8,.2,1) forwards; }
      @keyframes kS { to { transform: translate(-5px,-5px); } } @keyframes kL { to { transform: translate(5px,5px); } }
      @keyframes kC { to { transform: scale(1); } } @keyframes kR { to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) { .k-load { display: none; } .k-toast { transition: none; } }

      /* why + difference */
      .why { border-top: 1px solid rgba(255,255,255,.25); }
      .charts { display: grid; gap: 22px; margin-top: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
      .chart { margin: 0; padding: 22px; border: 1px solid rgba(255,255,255,.3); border-radius: 18px; background: rgba(0,52,214,.55); }
      .chart figcaption { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; margin-bottom: 20px; }
      .row { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin-bottom: 16px; font-size: .92rem; }
      .row .track { grid-column: 1 / -1; height: 14px; border-radius: 999px; background: rgba(255,255,255,.14); overflow: hidden; }
      .row b { font: 700 .95rem var(--mono); }
      .row i { display: block; height: 100%; width: 0; border-radius: 999px; transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
      .row i.w { background: #fff; } .row i.y { background: var(--yellow); }
      .chart.in .row i { width: var(--v); }
      .vs { border-top: 1px solid rgba(255,255,255,.25); }
      .ana-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      .ana[data-lang="it"] [lang="en"], .ana[data-lang="en"] [lang="it"] { display: none; }
      .note a { color: inherit; text-decoration: underline; }
      .vs-l { list-style: none; margin: 36px 0 0; padding: 0; display: grid; }
      .vs-l li { display: grid; gap: 4px 24px; grid-template-columns: 1fr; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,.28); line-height: 1.4; color: rgba(255,255,255,.85); }
      .vs-l b { font-size: 1.15rem; letter-spacing: -.02em; color: #fff; }
      .vs-f { font: 500 12px/1.6 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--yellow); }
      .vs-l li.me { background: rgba(255,224,0,.12); padding-left: 16px; padding-right: 16px; border-radius: 12px; border-bottom-color: transparent; margin-top: 6px; }
      .goal { margin-top: 40px; max-width: 46rem; } .goal p { margin: 14px 0 0; font-size: 1.1rem; line-height: 1.55; color: rgba(255,255,255,.9); }
      .goal-l { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
      .goal-l li { display: grid; grid-template-columns: 1.1em 1fr; } .goal-l li::before { content: '+'; font: 700 .95rem var(--mono); color: var(--yellow); }
      @media (min-width: 720px) { .vs-l li { grid-template-columns: 11rem 14rem 1fr; align-items: baseline; } }
      @media (min-width: 1024px) { .app { grid-template-columns: 1.1fr .9fr; } }
      @media (prefers-reduced-motion: reduce) { .row i { transition: none; } }
</style>

<script>
      document.querySelectorAll<HTMLElement>('[data-shot]').forEach((el) => {
        const fit = () => el.style.setProperty('--s', String(el.clientWidth / 1280));
        fit();
        new ResizeObserver(fit).observe(el);
      });

      // Anteprime live solo su desktop con mouse e solo vicino allo schermo; altrove resta il poster leggero.
      if (matchMedia('(min-width: 1024px) and (hover: hover)').matches) {
        const live = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          live.unobserve(e.target);
          const f = e.target.querySelector<HTMLIFrameElement>('iframe')!;
          f.addEventListener('load', () => f.classList.add('ready'), { once: true });
          f.src = f.dataset.src!;
        }), { rootMargin: '250px' });
        document.querySelectorAll('[data-shot]').forEach((v) => live.observe(v));
      }

      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.35 });
      document.querySelectorAll('.chart').forEach((c) => io.observe(c));
      const kScr = document.getElementById('kScr')!;
      const kLoad = document.getElementById('kLoad')!;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let kT = 0;
      const play = () => {
        clearTimeout(kT);
        kLoad.classList.remove('go', 'off'); void kLoad.offsetWidth; kLoad.classList.add('go');
        kT = window.setTimeout(() => kLoad.classList.add('off'), 3400);
      };
      if (still) kLoad.classList.add('off');
      else new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { play(); o.disconnect(); } }, { threshold: 0.5 }).observe(kScr);
      document.getElementById('kReplay')!.addEventListener('click', () => { if (!still) play(); });

      const tabs = kScr.querySelectorAll<HTMLElement>('[data-k-tab]');
      tabs.forEach((t) => t.addEventListener('click', () => {
        tabs.forEach((x) => x.classList.toggle('on', x === t));
        kScr.querySelectorAll('.k-pane').forEach((p) => p.classList.toggle('on', p.id === 'k-' + t.dataset.kTab));
      }));
      const toast = document.getElementById('kToast')!;
      let tT = 0;
      kScr.querySelectorAll<HTMLElement>('[data-k-toast]').forEach((b) => b.addEventListener('click', () => {
        toast.textContent = tr(b.dataset.kToast!); toast.classList.add('on');
        clearTimeout(tT); tT = window.setTimeout(() => toast.classList.remove('on'), 2200);
      }));
      const fb = document.getElementById('kFb')!;
      kScr.querySelectorAll<HTMLElement>('[data-k-msg]').forEach((b) => b.addEventListener('click', () => { fb.textContent = tr(b.dataset.kMsg!); fb.dataset.src = b.dataset.kMsg!; }));
      const IT: Record<string, string> = {
        'Follow the trail.': 'Segui la traccia.',
        'Find your<b>KERN</b>.': 'Trova il tuo <b>KERN</b>.',
        '1 of 3 done': '1 su 3 fatte',
        'All missions open': 'Tutte le missioni aperte',
        'Pick your<br>next <b>move.</b>': 'Scegli la<br>prossima <b>mossa.</b>',
        'Mission 002 · startup partner': 'Missione 002 · startup partner',
        'Fix what already exists': 'Sistema ciò che esiste già',
        "Make a real startup's onboarding screen clearer. The opposite of starting from a blank page.": "Rendi più chiara la schermata di onboarding di una vera startup. L'opposto di partire da una pagina bianca.",
        '128 answers · judged on quality': '128 risposte · giudicate sulla qualità',
        'Add your answer': 'Aggiungi la tua risposta',
        'Mission 003 · KERN': 'Missione 003 · KERN',
        'Rewrite a confusing email': "Riscrivi un'email confusa",
        'Do it your way. Every answer counts.': 'Fallo a modo tuo. Ogni risposta conta.',
        '54 answers': '54 risposte',
        'Mission 004 · studio client': 'Missione 004 · cliente dello studio',
        'Work with a partner': 'Lavora con un partner',
        'Answer together with someone else.': 'Rispondi insieme a qualcun altro.',
        '31 answers': '31 risposte',
        'Missions': 'Missioni',
        'yourKERN · first signs': 'yourKERN · primi segnali',
        'Your <b>KERN</b><br>so far.': 'Il tuo <b>KERN</b><br>finora.',
        'Time on KERN missions': 'Tempo sulle missioni KERN',
        'this week · only you see this': 'questa settimana · lo vedi solo tu',
        'What you seem drawn to': 'Cosa sembra attirarti',
        'Shaping ideas': 'Dare forma alle idee', 'Writing': 'Scrittura', 'Solo work': 'Lavoro in solitaria',
        'A first guess': 'Una prima ipotesi',
        'You seemed to light up on the open brief and drag on the polish.': 'Ti sei acceso sul brief aperto e hai faticato sulla rifinitura.',
        'Why we think so: you tried 3 versions of the open brief, and you wrote "time flew".': 'Perché lo pensiamo: hai provato 3 versioni del brief aperto e hai scritto "il tempo è volato".',
        'That feels right': 'Mi ci ritrovo', 'Not really': 'Non proprio',
        'Completed': 'Completate', 'Make somebody care': 'Fai importare a qualcuno', 'MISSION 001': 'MISSIONE 001',
        'Worth trying next': 'Da provare dopo', 'Improve an existing product page': 'Migliora la pagina di un prodotto esistente',
        'Tests the part you seemed to drag on.': 'Mette alla prova la parte in cui hai faticato.',
        'Your Trail': 'La tua traccia', 'Follow the<br><b>trail.</b>': 'Segui la<br><b>traccia.</b>',
        'Build from zero · done': 'Costruisci da zero · fatta', 'Improve what exists · in progress': 'Migliora ciò che esiste · in corso',
        'Pair up · not started': 'In coppia · da iniziare', 'Your Kern card': 'La tua Kern card',
        'What we saw, why, and your next move': 'Cosa abbiamo visto, perché e la tua prossima mossa',
        'Leave a sign': 'Lascia un segno', 'After each mission, leave one short tip for the next person.': 'Dopo ogni missione, lascia un breve consiglio per la persona dopo di te.',
        'Your answer is saved. Add another one anytime.': 'La tua risposta è salvata. Ne puoi aggiungere altre quando vuoi.',
        'Saved. This sharpens your KERN.': 'Salvato. Questo affina il tuo KERN.',
        "Noted. We'll give this guess less weight.": 'Preso nota. Daremo meno peso a questa ipotesi.',
      };
      let kLang = 'en';
      const tr = (s: string) => (kLang === 'it' && IT[s]) || s;
      const kTxt = kScr.querySelectorAll<HTMLElement>('.k-l, h4, h5, p, .k-sig, .k-chips span, .k-done span, .k-pill, .k-tag span, .k-tag strong, .k-ask button, .k-btn, .k-tabs button:not(:nth-child(2))');
      kTxt.forEach((e) => { e.dataset.en = e.innerHTML.trim(); });
      const setLang = (l: string) => {
        kLang = l;
        kTxt.forEach((e) => { const en = e.dataset.en!; if (en) e.innerHTML = tr(en); });
        if (fb.dataset.src) fb.textContent = tr(fb.dataset.src);
        document.querySelectorAll<HTMLElement>('[data-k-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kLang === l)));
      };
      document.querySelectorAll<HTMLElement>('[data-k-lang]').forEach((b) => b.addEventListener('click', () => setLang(b.dataset.kLang!)));
      document.querySelectorAll<HTMLElement>('[data-k-theme]').forEach((b) => b.addEventListener('click', () => {
        kScr.classList.toggle('light', b.dataset.kTheme === 'light');
        document.querySelectorAll<HTMLElement>('[data-k-theme]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }));
      const ana = document.getElementById('ana')!;
      const setAna = (l: string) => {
        ana.dataset.lang = l;
        document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.anaLang === l)));
      };
      document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.addEventListener('click', () => setAna(b.dataset.anaLang!)));
      if (!navigator.language.toLowerCase().startsWith('it')) setAna('en');
</script>
