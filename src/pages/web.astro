---
import Site from '../layouts/Site.astro';
import Sim from '../components/Sim.astro';
import Chat from '../components/Chat.astro';
const WA = `https://wa.me/393248423657?text=${encodeURIComponent('Ciao! Ho visto le vostre demo e vorrei parlarvi di un progetto.')}`;
const demos = [
  { slug: 'hair', name: 'SEZIONE', kind: 'Hair studio', line: 'Il sito di un salone, per lei e per lui.', tags: ['Lei / Lui', 'WebGL', 'Prenotazione'], next: ['Prenotazione con conferma su WhatsApp','Tessera fedeltà: ogni 6 servizi il 7° è in regalo', 'Coupon −15% sulla prima visita', 'Promemoria su WhatsApp prima della visita'] },
  { slug: 'innesto', name: 'INNESTO', kind: 'Ristrutturazioni', line: 'Ristrutturazioni, con casa 3D interattiva.', tags: ['WebGL', 'Case study', 'Preventivo'], next: ['Preventivo guidato in 4 domande', 'Area cliente con avanzamento del cantiere', 'Coupon sopralluogo gratuito a tempo', 'Sconto referral per chi consiglia lo studio'] },
  { slug: 'tattoo', name: 'Cultura Tattoo', kind: 'Tattoo gallery', line: 'Galleria tattoo con configuratore.', tags: ['Configuratore', 'Referral', '3D'], next: ['Tessera a timbri: la 5ª sessione ha uno sconto', 'Coupon flash per i giorni con più posti liberi', 'Acconto online dal configuratore', 'Statistiche su prenotazioni e ritorni'] },
];
const stats = [
  { t: 'Probabilità di vendere', a: { l: 'Nuovo contatto', v: 12.5, r: '5–20%' }, b: { l: 'Cliente già acquisito', v: 65, r: '60–70%' }, max: 100 },
  { t: 'Costo per ottenere un cliente', a: { l: 'Mantenerne uno', v: 1, r: '1×' }, b: { l: 'Trovarne uno nuovo', v: 15, r: '5–25×' }, max: 25 },
  { t: 'Profitto con +5% di clienti fedeli', a: { l: 'Oggi', v: 0, r: '—' }, b: { l: 'Con +5% di retention', v: 60, r: '+25–95%' }, max: 100 },
];
const feats = [
  { id: 'sito', t: 'Sito veloce', d: 'Più contatti ogni mese', n: 0.15, r: 0 },
  { id: 'fed', t: 'Tessera fedeltà', d: 'I clienti tornano più spesso', n: 0, r: 0.12 },
  { id: 'cp', t: 'Coupon', d: 'Riporta chi si era perso', n: 0.1, r: 0.05 },
  { id: 'wa', t: 'Promemoria WhatsApp', d: 'Meno appuntamenti saltati', n: 0, r: 0.06 },
  { id: 'ref', t: 'Referral', d: 'I clienti portano amici', n: 0.2, r: 0.02 },
];
---
<Site title="Lavori e demo — Punto Due Studio" description="Tre demo di siti complete e cliccabili, più un'app di fedeltà e coupon in concept: cosa costruiamo per far tornare i clienti." active="web">
      <section class="top">
        <span class="lab">/web</span>
        <h1>Nuovo link.</h1>
        <p class="lead">Tre siti da aprire e toccare con mano. Un click e sei dentro.</p>
      </section>

      <section class="demos" aria-label="Demo">
        {demos.map((d, i) => (
          <article class="card">
            <div class="shot">
              <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{d.slug === 'hair' ? 'sezione.it' : d.slug === 'innesto' ? 'innesto.it' : 'culturatattoo.it'}</span></div>
              <div class="view" data-shot>
                <img class="poster" src={`/previews/${d.slug}.webp`} width="960" height="600" alt="" loading="lazy" decoding="async" />
                <iframe data-src={`/demo/${d.slug}/index.html`} title={`Anteprima ${d.name}`} scrolling="no" tabindex="-1" aria-hidden="true"></iframe>
                <a class="cover" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener" aria-label={`Apri la demo ${d.name}`}><span>Apri la demo →</span></a>
              </div>
            </div>
            <div class="meta">
              <span class="lab">0{i + 1} · {d.kind}</span>
              <h3>{d.name}</h3>
              <p>{d.line}</p>
              <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
              <div class="next">
                <span class="lab">Prossime modifiche</span>
                <ul>{d.next.map((n) => <li>{n}</li>)}</ul>
              </div>
              <a class="lnk" href={`/demo/${d.slug}/index.html`} target="_blank" rel="noopener">Apri la demo →</a>
            </div>
          </article>
        ))}
      </section>

      <section class="app" id="app">
        <div class="app-txt">
          <span class="lab">/app · concept</span>
          <svg class="icon" viewBox="0 0 100 100" role="img" aria-label="Icona app Tessera">
            <rect width="100" height="100" rx="23" fill="#FFE000" />
            <rect x="19" y="27" width="62" height="46" rx="9" fill="#0034D6" transform="rotate(-6 50 50)" />
            <circle cx="35" cy="54" r="6" fill="#fff" transform="rotate(-6 50 50)" /><circle cx="50" cy="54" r="6" fill="#fff" transform="rotate(-6 50 50)" /><circle cx="65" cy="54" r="6" fill="none" stroke="#fff" stroke-width="2.5" transform="rotate(-6 50 50)" />
          </svg>
          <h2>Tessera</h2>
          <p class="lead">L'app di fedeltà e coupon per le attività locali: timbri, premi e sconti nel telefono del cliente, numeri chiari per te.</p>
          <dl class="spec">
            <div><dt>Piattaforme</dt><dd>iOS · Android · Web app</dd></div>
            <div><dt>Stato</dt><dd>Concept, in sviluppo</dd></div>
            <div><dt>Lingua</dt><dd>Italiano</dd></div>
            <div><dt>Dati</dt><dd>Nessun tracciamento pubblicitario</dd></div>
          </dl>
          <ul class="feat">
            <li><b>Programmi fedeltà</b><span>Tessera a timbri o a punti, premio automatico.</span></li>
            <li><b>Coupon sconto</b><span>Codici a tempo, per cliente o per giorno.</span></li>
            <li><b>Statistiche</b><span>Nuovi clienti, ritorni e coupon usati, in un colpo d'occhio.</span></li>
          </ul>
        </div>

        <div class="phone" aria-label="Anteprima interattiva dell'app">
          <div class="screen">
            <div class="ph-top"><span>Tessera</span></div>
            <div class="loy">
              <div class="loy-top" id="loyTop">
                <p class="loy-t">Ogni 8 visite, la 9ª è in regalo</p>
                <div class="stamps" id="stamps"></div>
                <div class="gift" id="gift" aria-hidden="true">
                  <svg viewBox="0 0 80 84">
                    <rect x="14" y="44" width="52" height="34" rx="4" fill="#FFE000" /><rect x="36" y="44" width="8" height="34" fill="#0034D6" />
                    <g class="lid"><rect x="10" y="32" width="60" height="14" rx="4" fill="#FFE000" /><rect x="36" y="32" width="8" height="14" fill="#0034D6" />
                    <path d="M40 32C30 14 18 22 26 30zM40 32C50 14 62 22 54 30z" fill="none" stroke="#fff" stroke-width="3.5" stroke-linejoin="round" /></g>
                  </svg>
                  <b>Premio sbloccato!</b>
                </div>
              </div>
              <p class="loy-s" id="loyMsg"></p>
              <button type="button" class="stamp-btn" id="stampBtn">Timbra</button>
            </div>
            <button type="button" class="ticket" id="coupon" aria-label="Copia il codice coupon">
              <span class="tk-l"><b>−15%</b><small>Bentornato</small></span>
              <span class="tk-r"><code>BENTORNATO15</code><small id="cpMsg">Tocca per copiare</small></span>
            </button>
            <div class="mini" aria-hidden="true"><i style="--h:30%"></i><i style="--h:42%"></i><i style="--h:38%"></i><i style="--h:58%"></i><i style="--h:66%"></i><i style="--h:82%"></i></div>
            <small class="mini-l">Clienti che tornano, ultime 6 settimane · esempio</small>
          </div>
        </div>
      </section>

      <section class="why" id="numeri">
        <span class="lab">/numeri</span>
        <h2>Far tornare un cliente vale di più.</h2>
        <p class="lead">Fedeltà e coupon servono a questo. Dati di ricerca generali, non risultati delle demo.</p>
        <div class="charts">
          {stats.map((s) => (
            <figure class="chart">
              <figcaption>{s.t}</figcaption>
              {[s.a, s.b].map((r, k) => (
                <div class="row">
                  <span>{r.l}</span>
                  <b>{r.r}</b>
                  <div class="track"><i class={k ? 'y' : 'w'} style={`--v:${(r.v / s.max) * 100}%`}></i></div>
                </div>
              ))}
            </figure>
          ))}
        </div>
        <p class="note">Le barre mostrano il centro dell'intervallo indicato dalle fonti.</p>
      </section>


      <Sim feats={feats} kpi={['Clienti attivi al 12° mese', 'Clienti che tornano', 'Nuovi clienti al mese']} heading="Accendi le funzioni." lead="Aggiungine una alla volta e guarda come cambiano i clienti in un anno." />

      <section class="cta-s">
        <Chat kind="sent" />
        <div class="cta">
          <a class="btn" href={WA} target="_blank" rel="noopener">Scrivici <span aria-hidden="true">→</span></a>
          <a class="lnk" href="mailto:projects@puntoduestudio.it">projects@puntoduestudio.it</a>
        </div>
      </section>

      <section class="src" id="fonti">
        <span class="lab">/fonti</span>
        <ol>
          <li>Amy Gallo, «The Value of Keeping the Right Customers», Harvard Business Review, ottobre 2014: aumentare la retention del 5% aumenta i profitti del 25–95%; acquisire un cliente costa 5–25 volte più che mantenerlo (dati di Fred Reichheld, Bain &amp; Company). <a href="https://hbr.org/2014/10/the-value-of-keeping-the-right-customers" target="_blank" rel="noopener">hbr.org</a></li>
          <li>P. Farris, N. Bendle, P. Pfeifer, D. Reibstein, <i>Marketing Metrics: The Definitive Guide to Measuring Marketing Performance</i>, Pearson, 2010: probabilità di vendita 5–20% a un nuovo contatto, 60–70% a un cliente esistente.</li>
          <li>Le demo INNESTO, SEZIONE e Cultura Tattoo sono concept realizzati da Punto Due Studio; i nomi e le attività sono fittizi. L'app Tessera è un concept: schermate e numeri sono d'esempio.</li>
        </ol>
      </section>
</Site>

<style is:global>
      .top { padding-bottom: 24px; }
      .demos { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); padding-top: 24px; }
      .card { display: flex; flex-direction: column; gap: 18px; }
      .shot { border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.35); background: var(--blue); transition: border-color .25s, transform .35s cubic-bezier(.2,.7,.2,1); }
      .shot:hover { border-color: var(--yellow); transform: translateY(-4px); }
      .bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; border-bottom: 1px solid rgba(255,255,255,.3); }
      .bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--yellow); }
      .bar i:nth-child(2) { background: #fff; } .bar i:nth-child(3) { background: transparent; box-shadow: inset 0 0 0 1.5px #fff; }
      .bar span { margin-left: 10px; font: 500 11px/1 var(--mono); letter-spacing: .1em; color: rgba(255,255,255,.75); }
      .view { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #0a0a0a; }
      .view iframe, .view .poster { position: absolute; left: 0; top: 0; width: 1280px; height: 800px; border: 0; transform: scale(var(--s, .3)); transform-origin: 0 0; pointer-events: none; }
      .view .poster { object-fit: cover; }
      .view iframe { background: #fff; opacity: 0; transition: opacity .5s; }
      .view iframe.ready { opacity: 1; }
      .cover { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-end; padding: 14px; background: linear-gradient(transparent 55%, rgba(0,52,214,.55)); transition: background .3s; }
      .cover span { background: var(--yellow); color: var(--blue); font-weight: 700; font-size: .95rem; padding: 10px 16px; border-radius: 999px; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .3s cubic-bezier(.2,.7,.2,1); }
      .shot:hover .cover span, .cover:focus-visible span { opacity: 1; transform: none; }
      .next { margin: 0 0 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.28); }
      .next ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; font-size: .95rem; line-height: 1.35; color: rgba(255,255,255,.88); }
      .next li { display: grid; grid-template-columns: 1.1em 1fr; }
      .next li::before { content: '+'; font: 700 .95rem var(--mono); color: var(--yellow); }
      .meta h3 { margin: 10px 0 8px; font-size: 1.9rem; }
      .meta p { margin: 0 0 14px; color: rgba(255,255,255,.85); line-height: 1.45; }
      .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 16px; padding: 0; }
      .tags li { font: 500 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; padding: 7px 10px; border: 1px solid rgba(255,255,255,.35); border-radius: 999px; }

      .app { display: grid; gap: clamp(32px, 6vw, 80px); grid-template-columns: 1fr; align-items: center; border-top: 1px solid rgba(255,255,255,.25); }
      .icon { width: 96px; height: 96px; display: block; margin: 22px 0 6px; filter: drop-shadow(0 10px 24px rgba(0,0,0,.25)); }
      .spec { margin: 26px 0 0; border-top: 1px solid rgba(255,255,255,.28); max-width: 34rem; }
      .spec div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.28); }
      .spec dt { font: 500 12px/1.6 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--yellow); }
      .spec dd { margin: 0; font-weight: 600; text-align: right; }
      .feat { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; max-width: 34rem; }
      .feat b { display: block; font-size: 1.1rem; letter-spacing: -.01em; }
      .feat span { color: rgba(255,255,255,.8); }
      .ph-top { display: flex; justify-content: space-between; align-items: baseline; }
      .ph-top span { font-weight: 700; font-size: 1.3rem; letter-spacing: -.03em; color: var(--blue); }
      .ph-top small, .mini-l { font-size: 11px; color: #5a6178; }
      .loy { background: var(--blue); color: #fff; border-radius: 20px; padding: 16px; }
      .loy { position: relative; }
      .loy-top { position: relative; }
      .gift { position: absolute; inset: -6px; display: grid; place-content: center; justify-items: center; gap: 6px; border-radius: 14px; background: var(--blue); opacity: 0; pointer-events: none; transition: opacity .3s; }
      .gift svg { width: 84px; height: auto; overflow: visible; transform: scale(.4); }
      .gift .lid { transform-box: fill-box; transform-origin: 0% 100%; }
      .gift b { font-size: .95rem; letter-spacing: -.01em; color: var(--yellow); opacity: 0; transform: translateY(6px); transition: opacity .4s .5s, transform .4s .5s; }
      .gift.show { opacity: 1; }
      .gift.show svg { animation: giftPop .7s cubic-bezier(.2,1.4,.4,1) both, giftBob 1.6s ease-in-out 1.2s infinite; }
      .gift.show .lid { animation: lidOpen .6s .45s cubic-bezier(.2,1.3,.4,1) both; }
      .gift.show b { opacity: 1; transform: none; }
      .conf { position: absolute; left: 50%; top: 45%; width: 7px; height: 11px; border-radius: 2px; pointer-events: none; }
      @keyframes giftPop { from { transform: scale(.3) rotate(-8deg); } 60% { transform: scale(1.12) rotate(3deg); } to { transform: none; } }
      @keyframes giftBob { 50% { transform: translateY(-4px); } }
      @keyframes lidOpen { to { transform: translateY(-16px) rotate(-16deg); } }
      @media (prefers-reduced-motion: reduce) { .gift.show svg, .gift.show .lid { animation: none; } .gift svg { transform: none; } .gift.show .lid { transform: translateY(-14px); } }
      .loy-t { margin: 0 0 12px; font-weight: 600; font-size: .95rem; }
      .stamps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      .stamps i { aspect-ratio: 1; border-radius: 50%; border: 2px dashed rgba(255,255,255,.5); transition: background .3s, transform .3s, border-color .3s; }
      .stamps i.on { background: var(--yellow); border: 2px solid var(--yellow); }
      .stamps i.pop { animation: pop .35s cubic-bezier(.2,.9,.3,1.5); }
      @keyframes pop { from { transform: scale(.4); } }
      .loy-s { margin: 12px 0 0; font-size: .85rem; min-height: 1.2em; color: rgba(255,255,255,.9); }
      .stamp-btn { margin-top: 10px; width: 100%; border: 0; border-radius: 999px; padding: 12px; font: 700 .95rem 'Inter Tight Variable', system-ui, sans-serif; background: var(--yellow); color: var(--blue); cursor: pointer; transition: transform .2s; }
      .stamp-btn:active { transform: scale(.97); }
      .ticket { display: flex; align-items: stretch; width: 100%; border: 0; padding: 0; text-align: left; border-radius: 14px; background: #fff; box-shadow: 0 2px 0 rgba(0,52,214,.12); cursor: pointer; font-family: inherit; color: inherit; overflow: hidden; }
      .tk-l { display: grid; align-content: center; padding: 12px 14px; background: var(--yellow); color: var(--blue); border-right: 2px dashed rgba(0,52,214,.4); }
      .tk-l b { font-size: 1.5rem; letter-spacing: -.04em; line-height: 1; }
      .tk-l small { font-size: 10px; font-weight: 600; }
      .tk-r { display: grid; align-content: center; gap: 4px; padding: 12px 14px; }
      .tk-r code { font: 700 .9rem var(--mono); letter-spacing: .06em; color: var(--blue); }
      .tk-r small { font-size: 11px; color: #5a6178; }
      .mini { display: flex; align-items: flex-end; gap: 8px; height: 64px; }
      .mini i { flex: 1; height: var(--h); border-radius: 6px 6px 2px 2px; background: var(--blue); opacity: .85; }
      .mini i:last-child { background: var(--yellow); opacity: 1; }

      .why { border-top: 1px solid rgba(255,255,255,.25); }
      .charts { display: grid; gap: 22px; margin-top: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
      .chart { margin: 0; padding: 22px; border: 1px solid rgba(255,255,255,.3); border-radius: 18px; background: rgba(0,52,214,.55); }
      .chart figcaption { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; margin-bottom: 20px; }
      .row { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin-bottom: 16px; font-size: .92rem; }
      .row .track { grid-column: 1 / -1; height: 14px; border-radius: 999px; background: rgba(255,255,255,.14); overflow: hidden; }
      .row b { font: 700 .95rem var(--mono); }
      .row i { display: block; height: 100%; width: 0; border-radius: 999px; transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
      .row i.w { background: #fff; } .row i.y { background: var(--yellow); }
      .chart.in .row i { width: var(--v); }
      @media (min-width: 1024px) { .app { grid-template-columns: 1.1fr .9fr; } }
      @media (prefers-reduced-motion: reduce) { .row i { transition: none; } .stamps i.pop { animation: none; } }
</style>

<script>
      document.querySelectorAll<HTMLElement>('[data-shot]').forEach((el) => {
        const fit = () => el.style.setProperty('--s', String(el.clientWidth / 1280));
        fit();
        new ResizeObserver(fit).observe(el);
      });

      // Anteprime live solo su desktop con mouse e solo vicino allo schermo; altrove resta il poster leggero.
      if (matchMedia('(min-width: 1024px) and (hover: hover)').matches) {
        const live = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          live.unobserve(e.target);
          const f = e.target.querySelector<HTMLIFrameElement>('iframe')!;
          f.addEventListener('load', () => f.classList.add('ready'), { once: true });
          f.src = f.dataset.src!;
        }), { rootMargin: '250px' });
        document.querySelectorAll('[data-shot]').forEach((v) => live.observe(v));
      }

      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.35 });
      document.querySelectorAll('.chart').forEach((c) => io.observe(c));

      const box = document.getElementById('stamps')!;
      const msg = document.getElementById('loyMsg')!;
      const btn = document.getElementById('stampBtn')!;
      const TOTAL = 8;
      let n = 5;
      box.innerHTML = '<i></i>'.repeat(TOTAL);
      const paint = (pop = false) => {
        [...box.children].forEach((c, i) => { c.classList.toggle('on', i < n); c.classList.remove('pop'); });
        if (pop && n > 0) { const c = box.children[n - 1] as HTMLElement; void c.offsetWidth; c.classList.add('pop'); }
        const left = TOTAL - n;
        msg.textContent = left > 0 ? `Ancora ${left} per il premio` : 'La prossima visita è in regalo';
        btn.textContent = left > 0 ? 'Timbra' : 'Ricomincia';
      };
      const gift = document.getElementById('gift')!;
      const top = document.getElementById('loyTop')!;
      const celebrate = () => {
        gift.classList.add('show');
        navigator.vibrate?.(60);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const cols = ['#FFE000', '#ffffff', '#ff5fa2', '#7cf0c9', '#ffb020'];
        for (let i = 0; i < 26; i++) {
          const c = document.createElement('i');
          c.className = 'conf'; c.style.background = cols[i % cols.length];
          top.appendChild(c);
          const a = Math.random() * Math.PI * 2, r = 70 + Math.random() * 90;
          c.animate([
            { transform: 'translate(-50%,-50%) rotate(0)', opacity: 1 },
            { transform: `translate(${Math.cos(a) * r - 3}px,${Math.sin(a) * r - 40}px) rotate(${Math.random() * 540}deg)`, opacity: 1, offset: .55 },
            { transform: `translate(${Math.cos(a) * r * 1.1}px,${Math.sin(a) * r + 50}px) rotate(${Math.random() * 900}deg)`, opacity: 0 },
          ], { duration: 1300 + Math.random() * 500, delay: 420, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'both' }).onfinish = () => c.remove();
        }
      };
      btn.addEventListener('click', () => {
        n = n >= TOTAL ? 0 : n + 1;
        paint(true);
        if (n >= TOTAL) celebrate(); else gift.classList.remove('show');
      });
      paint();

      const cp = document.getElementById('coupon')!;
      const cpMsg = document.getElementById('cpMsg')!;
      cp.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText('BENTORNATO15'); cpMsg.textContent = 'Copiato!'; } catch { cpMsg.textContent = 'Codice: BENTORNATO15'; }
        setTimeout(() => (cpMsg.textContent = 'Tocca per copiare'), 1800);
      });
</script>
