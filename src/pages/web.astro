      inEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); sendChat(); } });
      document.querySelectorAll<HTMLElement>('#kEx span').forEach((c, i) => {
        const go = () => {
          if (i === 1) return resetChat();
          const f = FIELDS[kField] || FIELDS.Design;
          inEl.value = tr(f.idea).replace(/^[^:]+:\s*/, ''); inEl.focus();
        };
        c.addEventListener('click', go);
        c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
      });
      resetChat();
      const setAna = (l: string) => {
        document.documentElement.dataset.ana = l;
        document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.anaLang === l)));
      };
      document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.addEventListener('click', () => setAna(b.dataset.anaLang!)));
      if (!navigator.language.toLowerCase().startsWith('it')) setAna('en');
</script>
