      .chart { margin: 0; padding: 22px; border: 1px solid rgba(255,255,255,.3); border-radius: 18px; background: rgba(0,52,214,.55); }
      .chart figcaption { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; margin-bottom: 20px; }
      .row { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin-bottom: 16px; font-size: .92rem; }
      .row .track { grid-column: 1 / -1; height: 14px; border-radius: 999px; background: rgba(255,255,255,.14); overflow: hidden; }
      .row b { font: 700 .95rem var(--mono); }
      .row i { display: block; height: 100%; width: 0; border-radius: 999px; transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
      .row i.w { background: #fff; } .row i.y { background: var(--yellow); }
      .chart.in .row i { width: var(--v); }
      .k-tags { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
      .k-tags li { border: 1px solid rgba(255,255,255,.4); border-radius: 999px; padding: 9px 16px; font-weight: 600; font-size: .95rem; background: rgba(255,255,255,.06); }
      .k-wrap > * { position: relative; z-index: 1; }
      .k-wrap::before { content: ''; position: absolute; inset: 6% -14%; background: radial-gradient(closest-side, rgba(255,224,0,.22), rgba(255,224,0,.08) 60%, transparent 100%); pointer-events: none; }
      .ana-top { display: flex; justify-content: flex-start; margin-bottom: 4px; align-items: center; gap: 18px; flex-wrap: wrap; }
      html:not([data-ana="en"]) span[lang="en"], html[data-ana="en"] span[lang="it"] { display: none; }
      .note a { color: inherit; text-decoration: underline; }
      @media (min-width: 1024px) { .app { grid-template-columns: 1.1fr .9fr; } }
      @media (prefers-reduced-motion: reduce) { .row i { transition: none; } }
</style>

<script>
      document.querySelectorAll<HTMLElement>('[data-shot]').forEach((el) => {
        const fit = () => el.style.setProperty('--s', String(el.clientWidth / 1280));
        fit();
        new ResizeObserver(fit).observe(el);
      });

      // Anteprime live solo su desktop con mouse e solo vicino allo schermo; altrove resta il poster leggero.
      if (matchMedia('(min-width: 1024px) and (hover: hover)').matches) {
        const live = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          live.unobserve(e.target);
          const f = e.target.querySelector<HTMLIFrameElement>('iframe')!;
          f.addEventListener('load', () => f.classList.add('ready'), { once: true });
          f.src = f.dataset.src!;
        }), { rootMargin: '250px' });
        document.querySelectorAll('[data-shot]').forEach((v) => live.observe(v));
      }

      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.35 });
      document.querySelectorAll('.chart').forEach((c) => io.observe(c));
      // slashkern: l'anteprima dell'app (apertura, tre schede, progetti, KernCard, Slash)
      const sk = document.getElementById('sk')!;
      const $sk = <T extends HTMLElement = HTMLElement>(s: string) => sk.querySelector<T>(s)!;
      const $$sk = <T extends HTMLElement = HTMLElement>(s: string) => [...sk.querySelectorAll<T>(s)];
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const skLoad = $sk('#skLoad');
      // l'anteprima mostra solo l'apertura dell'app: la schermata di caricamento resta, l'app non si apre.
      // Il resto dell'app (schede, progetti, KernCard, Slash) è sotto, spento: per riaprirla basta rimettere `off` dopo l'animazione.
      [...sk.children].forEach((c) => { if (c !== skLoad) { c.setAttribute('inert', ''); c.setAttribute('aria-hidden', 'true'); } });
      const playLoad = () => { skLoad.classList.remove('go'); void skLoad.offsetWidth; skLoad.classList.add('go'); };
      if (still) skLoad.classList.add('go');
      else new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { playLoad(); o.disconnect(); } }, { threshold: 0.5 }).observe(sk);
      const replay = document.getElementById('kReplay')!;
      if (still) replay.hidden = true; // senza animazioni non c'è un'apertura da rivedere
      else replay.addEventListener('click', playLoad);

      const tabs = $$sk('[data-sk-tab]');
      const showTab = (name: string) => {
        tabs.forEach((t) => { const on = t.dataset.skTab === name; t.classList.toggle('on', on); on ? t.setAttribute('aria-current', 'page') : t.removeAttribute('aria-current'); });
        $$sk('.sk-pane').forEach((p) => p.classList.toggle('on', p.id === 'sk-' + name));
        $sk('#skBody').scrollTo({ top: 0 });
      };
      tabs.forEach((t) => t.addEventListener('click', () => showTab(t.dataset.skTab!)));

      // Progetti: "Altri percorsi" apre le 7 categorie; scegliendone una cambiano titolo e progetto
      const more = $sk('#skMore'), paths = $sk('#skPaths');
      // le etichette bilingui (<span lang>) si copiano così come sono: la lingua la sceglie il CSS
      const bi = (el: Element) => [...el.querySelectorAll(':scope > span[lang]')].map((s) => s.outerHTML).join('');
      more.addEventListener('click', () => { paths.hidden = !paths.hidden; more.setAttribute('aria-expanded', String(!paths.hidden)); });
      $$sk('.sk-path').forEach((b) => b.addEventListener('click', () => {
        $$sk('.sk-path').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        $$sk('.sk-piece').forEach((p) => (p.hidden = p.dataset.f !== b.dataset.f));
        $sk('#skField').innerHTML = bi(b);
        paths.hidden = true; more.setAttribute('aria-expanded', 'false');
      }));

      // KernCard: ogni progetto finito riempie il percorso (6 tacche), va sul retro e porta pietre (numeri d'esempio)
      const STONES_PER_PROJECT = 60;
      const done: HTMLElement[] = [];
      const lad = $$sk('#skLad > span'); // solo le 5 celle, non gli <span lang> dentro
      const renderCard = () => {
        const stones = done.length * STONES_PER_PROJECT;
        const rank = lad.reduce((a, s, i) => (stones >= Number(s.dataset.s) ? i : a), 0);
        $$sk('.sk-bar i').forEach((i, k) => i.classList.toggle('on', k < done.length));
        $$sk('.sk-n').forEach((n) => (n.textContent = String(Math.min(done.length, 6))));
        $$sk('.sk-rn').forEach((r, i) => (r.hidden = i !== rank));
        lad.forEach((s, i) => { s.classList.toggle('done', i < rank); s.classList.toggle('on', i === rank); });
        $sk('#skSt').textContent = String(stones);
        const last = done[done.length - 1];
        if (!last) return;
        $sk('#skQ').innerHTML = bi(last.querySelector('h4')!);
        const field = $$sk('.sk-path').find((b) => b.dataset.f === last.dataset.f)!;
        $$sk('.sk-cf').forEach((c) => (c.innerHTML = bi(field)));
        $sk('#skList').innerHTML = done.map((p) => `<li>${bi(p.querySelector('h4')!)}</li>`).join('');
      };
      renderCard(); // il Ciottolo è già acceso sulla scala
      const saved = $sk('#skSaved');
      // mentre il foglio è aperto, il resto del telefono non si raggiunge col Tab
      const behind = [$sk('.sk-top'), $sk('#skBody'), $sk('.sk-tabs')];
      let opener: HTMLElement | null = null;
      // preventScroll: spostare il focus dentro il telefono non deve far scorrere la pagina
      const closeSaved = (to?: string) => {
        saved.hidden = true;
        behind.forEach((el) => (el.inert = false));
        if (to) showTab(to);
        (to ? tabs.find((t) => t.dataset.skTab === to) : opener)?.focus({ preventScroll: true });
      };
      $$sk('[data-start]').forEach((b) => b.addEventListener('click', () => {
        const piece = b.closest<HTMLElement>('.sk-piece')!;
        if (!done.includes(piece)) { done.push(piece); b.classList.add('done'); renderCard(); }
        opener = b; saved.hidden = false;
        behind.forEach((el) => (el.inert = true));
        $sk('#skSeeCard').focus({ preventScroll: true });
      }));
      $sk('#skSeeCard').addEventListener('click', () => closeSaved('kerncard'));
      $sk('#skStay').addEventListener('click', () => closeSaved());
      saved.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSaved(); });

      // la carta si inclina verso il dito/mouse (al massimo 9 gradi, come nell'app) e si gira
      const card = $sk('#skCard'), stage = $sk('#skStage'), flipB = $sk('#skFlip');
      const MAX_TILT = 9;
      if (!still) {
        stage.addEventListener('pointermove', (e) => {
          const r = stage.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          card.classList.add('live');
          card.style.setProperty('--ry', `${(x - 0.5) * 2 * MAX_TILT}deg`); card.style.setProperty('--rx', `${(0.5 - y) * 2 * MAX_TILT}deg`);
          card.style.setProperty('--mx', `${x * 100}%`); card.style.setProperty('--my', `${y * 100}%`);
        });
        stage.addEventListener('pointerleave', () => { card.classList.remove('live'); ['--rx', '--ry', '--mx', '--my'].forEach((p) => card.style.removeProperty(p)); });
      }
      flipB.addEventListener('click', () => {
        const back = card.classList.toggle('flip');
        flipB.setAttribute('aria-pressed', String(back));
        $sk('.sk-front').setAttribute('aria-hidden', String(back)); $sk('.sk-back').setAttribute('aria-hidden', String(!back));
      });

      // Slash: una domanda alla volta; la bozza arriva solo se la chiedi ed è segnata come aiuto dell'AI
      const step = (n: number) => {
        $$sk('#skChat [data-s]').forEach((el) => (el.hidden = Number(el.dataset.s) > n));
        $sk('#skChat .sk-chips').hidden = n > 0;
        $sk('.sk-draft').hidden = n !== 1;
      };
      const later = (fn: () => void) => (still ? fn() : window.setTimeout(fn, 550));
      $$sk('.sk-chip').forEach((c) => c.addEventListener('click', () => {
        const me = $sk('#skChat .sk-me');
        me.innerHTML = bi(c);
        $sk('#skChat .sk-chips').hidden = true;
        me.hidden = false;
        later(() => step(1));
      }));
      $sk('.sk-draft').addEventListener('click', () => { $sk('.sk-draft').hidden = true; later(() => step(2)); });
      $sk('#skAgain').addEventListener('click', () => step(0));
      step(0);
      const setAna = (l: string) => {
        document.documentElement.dataset.ana = l;
        document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.anaLang === l)));
      };
      document.querySelectorAll<HTMLElement>('[data-ana-lang]').forEach((b) => b.addEventListener('click', () => setAna(b.dataset.anaLang!)));
      if (!navigator.language.toLowerCase().startsWith('it')) setAna('en');
</script>
