---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import textFont from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '../styles/ui.css';
import { siWhatsapp } from 'simple-icons';
import LangAuto from '../components/LangAuto.astro';
import LangMenu from '../components/LangMenu.astro';
// noindex: pagine da mandare con un link (es. il modulo per i clienti), fuori da Google e senza traduzioni
// itOnly: pagina solo italiana ma indicizzata (es. note legali): niente pulsante lingua né hreflang verso traduzioni che non esistono
interface Props { title: string; description: string; active?: 'web' | 'social' | 'motion' | 'info'; noindex?: boolean; itOnly?: boolean }
const { title, description, active, noindex, itOnly } = Astro.props;
// Le pagine sotto /en/ e /de/ sono le traduzioni generate da scripts/i18n.mjs (nuova lingua: aggiungerla anche lì)
const path = Astro.url.pathname;
const LANGS = ['it', 'en', 'de'] as const;
type Lang = typeof LANGS[number];
const lang: Lang = LANGS.find((l) => l !== 'it' && (path === '/' + l || path.startsWith('/' + l + '/'))) ?? 'it';
const itPath = lang === 'it' ? path : path.slice(lang.length + 1) || '/';
const pathIn = (l: Lang) => (l === 'it' ? itPath : '/' + l + (itPath === '/' ? '/' : itPath));
const L = lang === 'it' ? '' : '/' + lang;
const SITE = 'https://puntoduestudio.it';
// La KERN preview in /web esiste solo in italiano e inglese: le lingue senza versione propria mostrano l'inglese
const ana = lang === 'it' ? undefined : 'en';
type Str = { og: string; main: string; links: string; rights: string; faq: string; legal: string; privacy: string; to: string; services: string; write: string; menu: string; close: string; top: string; waText: string; langNote: string; next: string; skip: string };
const T: Record<Lang, Str> = {
  it: { og: 'it_IT', main: 'Principale', links: 'Collegamenti', rights: 'Tutti i diritti riservati', faq: 'Domande frequenti', legal: 'Note legali', privacy: 'Privacy', to: 'Versione italiana', services: 'Servizi', write: 'Scrivici', menu: 'Menu', close: 'Chiudi', top: 'Torna su', waText: 'Ciao! Vorrei parlarvi di un progetto. Quando potremmo sentirci?', langNote: "Il sito si apre nella lingua del tuo dispositivo; se non c'è, in inglese.", next: 'Prossima pagina', skip: 'Vai al contenuto' },
  en: { og: 'en_GB', main: 'Main', links: 'Links', rights: 'All rights reserved', faq: 'FAQ', legal: 'Legal notice (IT)', privacy: 'Privacy (IT)', to: 'English version', services: 'Services', write: 'Write to us', menu: 'Menu', close: 'Close', top: 'Back to top', waText: 'Hi! I’d like to talk to you about a project. When could we speak?', langNote: 'The site opens in your device’s language; if it isn’t available, in English.', next: 'Next page', skip: 'Skip to content' },
  de: { og: 'de_DE', main: 'Hauptnavigation', links: 'Links', rights: 'Alle Rechte vorbehalten', faq: 'Häufige Fragen', legal: 'Rechtliche Hinweise (IT)', privacy: 'Datenschutz (IT)', to: 'Deutsche Version', services: 'Leistungen', write: 'Schreiben Sie uns', menu: 'Menü', close: 'Schließen', top: 'Nach oben', waText: 'Hallo! Ich möchte mit Ihnen über ein Projekt sprechen. Wann könnten wir uns austauschen?', langNote: 'Die Website öffnet sich in der Sprache Ihres Geräts; ist sie nicht verfügbar, auf Englisch.', next: 'Nächste Seite', skip: 'Zum Inhalt springen' },
};
const t = T[lang];
const showLangs = !noindex && !itOnly;
const WA = `https://wa.me/393248423657?text=${encodeURIComponent(t.waText)}`;
const showCta = !noindex && active !== 'info';
const nextOf = ({ web: 'social', social: 'motion', motion: 'info' } as Record<string, string>)[active ?? ''];
const navItems = [['web', '/web/'], ['social', '/social/'], ['motion', '/motion/'], ['info', '/info/']] as const;
---
<!doctype html>
<html lang={lang} data-ana={ana} data-build="2026-10-09">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0034D6" />
    <noscript><style>.mnav{position:static;visibility:visible;clip-path:none;padding:96px var(--gut) 24px}.menu-btn,.mnav-x{display:none}.mnav-li{opacity:1;transform:none}</style></noscript>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    {showLangs && <LangAuto />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="manifest" href="/site.webmanifest" />
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, "https://puntoduestudio.it")} />}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE)} />
    <meta property="og:site_name" content="Punto Due Studio" />
    <meta property="og:image" content="https://puntoduestudio.it/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Punto Due Studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={t.og} />
    {!noindex && <link rel="alternate" type="text/markdown" href={SITE + (path.endsWith('/') ? path : path + '/') + 'index.md'} />}
    {noindex && <meta name="robots" content="noindex" />}
    {showLangs && <>
      {LANGS.map((l) => <link rel="alternate" hreflang={l} href={SITE + pathIn(l)} />)}
      <link rel="alternate" hreflang="x-default" href={SITE + pathIn('en')} />
    </>}
    <!-- Cloudflare Web Analytics: statistiche di visita aggregate, senza cookie -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "1013794909284091af82872b6126a728"}'></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="hdr">
      <a class="brand" href={L + '/'} aria-label="Punto Due Studio">
        <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
          <defs><clipPath id="lc"><circle class="pc" cx="37" cy="50" r="27" /></clipPath></defs>
          <circle class="pa" cx="37" cy="50" r="27" fill="#fff" /><circle class="pb" cx="63" cy="50" r="27" fill="#FFE000" /><circle class="pl" cx="63" cy="50" r="27" fill="#0034D6" clip-path="url(#lc)" />
        </svg>
        <span class="word"><span class="name">Punto Due</span> <span class="sub">STUDIO</span></span>
      </a>
      <nav class="nav" aria-label={t.main}>
        <i class="nav-ind" aria-hidden="true"></i>
        {navItems.map(([k, href]) => <a href={L + href} class={active === k ? 'on' : undefined} aria-current={active === k ? 'page' : undefined}>/{k}</a>)}
      </nav>
      <div class="hdr-r">
        {showLangs && <LangMenu />}
        {showCta && <a class="btn btn-s hdr-cta" href={L + '/info/'}>{t.write}</a>}
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav"><span class="menu-ic" aria-hidden="true"></span>{t.menu}</button>
      </div>
    </header>

    <div class="mnav" id="mnav" role="dialog" aria-modal="true" aria-label={t.menu}>
      <button class="btn btn-s ghost mnav-x" type="button">{t.close}</button>
      <ol>
        {navItems.map(([k, href], i) => <li class="mnav-li" style={`--i:${i}`}><a href={L + href} aria-current={active === k ? 'page' : undefined}>/{k}<small>0{i + 1}</small></a></li>)}
      </ol>
      <div class="mnav-more mnav-li" style="--i:4">
        <a href={L + '/servizi/'}>{t.services}</a>
        <a href={L + '/faq/'}>{t.faq}</a>
        <a href="https://www.instagram.com/puntoduestudio/" target="_blank" rel="noopener">Instagram</a>
        <a href="mailto:studio@puntoduestudio.it">studio@puntoduestudio.it</a>
      </div>
      <div class="mnav-foot mnav-li" style="--i:5">
        {showCta && <a class="btn" href={L + '/info/'}>{t.write}</a>}
        {showLangs && <LangMenu inline />}
      </div>
    </div>

    {showCta && (
      <aside class="dock" aria-label={t.write}>
        <a class="btn" href={L + '/info/'}>{t.write}</a>
        <a class="wa" href={WA} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg></a>
      </aside>
    )}

    <canvas id="bg" aria-hidden="true"></canvas>

    <main id="main">
      <slot />
      {nextOf && (
        <a class="nextp" href={`${L}/${nextOf}/`}>
          <span class="lab">{t.next}</span>
          <span class="nextp-t">/{nextOf}</span>
          <span class="nextp-a" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      )}
      <footer class="ftr">
        <span>© 2026 Punto Due Studio · {t.rights}</span>
        {showLangs && <p class="lang-note">{t.langNote}</p>}
        <nav class="ftr-links" aria-label={t.links}>
          <a href="https://www.instagram.com/puntoduestudio/" target="_blank" rel="noopener">Instagram</a>
          <a href="mailto:studio@puntoduestudio.it">studio@puntoduestudio.it</a>
          <a href={L + '/servizi/'}>{t.services}</a>
          <a href={L + '/faq/'}>{t.faq}</a>
          <a href="/note-legali/">{t.legal}</a>
          <a href="/privacy/">{t.privacy}</a>
          <a href="/privacy/#cookie">Cookie</a>
        </nav>
        <button class="top-btn" type="button">{t.top} <span aria-hidden="true">↑</span></button>
      </footer>
    </main>

    <style is:global>
      html { scroll-behavior: smooth; scroll-padding-top: 110px; }
      body { margin: 0; color: #fff; font-family: 'Inter Tight Variable', system-ui, sans-serif; background: var(--blue); overflow-x: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      #bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; background: var(--blue); }
      main { position: relative; z-index: 1; padding-top: 104px; }
      main > section { padding: clamp(48px, 9vh, 110px) var(--gut); }
      main > section.cta-s { padding: clamp(32px, 6vw, 72px); }
      h1, h2, h3 { margin: 0; letter-spacing: -.03em; }
      h1, h2 { text-wrap: balance; } /* niente parola sola sull'ultima riga dei titoli grandi */
      h1 { margin-top: 18px; font-size: clamp(3.2rem, 9vw, 8rem); line-height: .9; font-weight: 800; }
      h2 { margin-top: 18px; font-size: clamp(2.3rem, 5.2vw, 4.6rem); line-height: .96; }
      .lead { margin: 20px 0 0; max-width: 36rem; font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; color: rgba(255,255,255,.85); }
      .phone { justify-self: center; width: min(320px, 100%); padding: 10px; border-radius: 44px; background: #0a0f24; border: 2px solid rgba(255,255,255,.35); box-shadow: 0 30px 80px rgba(0,0,0,.35); transition: transform .25s ease-out; will-change: transform; }
      .screen { border-radius: 34px; background: #f6f7fb; color: #0a0f24; padding: 20px 16px 18px; display: grid; gap: 14px; }
      .note { margin: 18px 0 0; font-size: .85rem; color: rgba(255,255,255,.7); }
      .src { padding-top: 0 !important; }
      .src ol { margin: 18px 0 0; padding-left: 1.2em; max-width: 52rem; display: grid; gap: 12px; font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.8); }
      .src a { color: var(--yellow); }
      .ftr { border-top: 1px solid rgba(255,255,255,.2); margin-top: clamp(40px, 8vh, 96px); }
      /* entrata dei blocchi allo scroll (solo pagine interne: la home le anima con GSAP) */
      .rv { opacity: 0; transform: translateY(28px); transition: opacity .8s var(--ease), transform .9s var(--ease); transition-delay: var(--dl, 0s); }
      .rv.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }
    </style>

    <script>
      import '../scripts/ui.ts';
      const cv = document.getElementById('bg') as HTMLCanvasElement;
      const gl = cv.getContext('webgl', { antialias: false, alpha: false });
      if (gl) {
        const sh = (t: number, src: string) => { const o = gl.createShader(t)!; gl.shaderSource(o, src); gl.compileShader(o); return o; };
        const pr = gl.createProgram()!;
        gl.attachShader(pr, sh(gl.VERTEX_SHADER, 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}'));
        gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, `precision mediump float;
uniform vec2 res,mouse;uniform float t,scroll,dpr;uniform vec3 rip[4];
void main(){
  vec2 p=gl_FragCoord.xy; p.y+=scroll;
  float cell=28.*dpr; vec2 g=mod(p,cell)-cell*.5; vec2 c=p-g;
  vec2 m=vec2(mouse.x,mouse.y+scroll);
  float glow=exp(-length(c-m)/(170.*dpr));
  float r=1.2*dpr*(1.+2.4*glow), wave=0.;
  for(int i=0;i<4;i++){ float age=t-rip[i].z; if(age>0.&&age<3.){ float d=length(c-vec2(rip[i].x,rip[i].y+scroll))-age*650.*dpr; wave+=exp(-d*d/(2500.*dpr*dpr))*exp(-age*1.3); } }
  r+=3.4*dpr*wave;
  float a=clamp(r-length(g)+.5,0.,1.);
  vec3 blue=vec3(0.,.204,.839);
  vec3 col=mix(vec3(1.),vec3(1.,.878,0.),clamp(glow+wave,0.,1.));
  gl_FragColor=vec4(mix(blue,col,a*(.17+.75*glow+.8*wave)),1.);
}`));
        gl.linkProgram(pr); gl.useProgram(pr);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const al = gl.getAttribLocation(pr, 'a'); gl.enableVertexAttribArray(al); gl.vertexAttribPointer(al, 2, gl.FLOAT, false, 0, 0);
        const U = (n: string) => gl.getUniformLocation(pr, n);
        const dpr = Math.min(devicePixelRatio || 1, innerWidth < 700 ? 1 : 1.5);
        let dirty = true, lastY = -1, lastRip = -100;
        const mouse = { x: -9999, y: -9999 };
        const rips = new Float32Array(12).fill(0); for (let i = 2; i < 12; i += 3) rips[i] = -100;
        let ri = 0, t0 = performance.now();
        const size = () => { cv.width = innerWidth * dpr; cv.height = innerHeight * dpr; gl.viewport(0, 0, cv.width, cv.height); };
        size(); addEventListener('resize', () => { size(); dirty = true; });
        addEventListener('pointermove', (e) => { mouse.x = e.clientX * dpr; mouse.y = (innerHeight - e.clientY) * dpr; dirty = true; });
        addEventListener('pointerdown', (e) => {
          mouse.x = e.clientX * dpr; mouse.y = (innerHeight - e.clientY) * dpr;
          lastRip = (performance.now() - t0) / 1000;
          rips.set([mouse.x, mouse.y, lastRip], ri * 3); ri = (ri + 1) % 4;
        });
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const draw = () => {
          gl.uniform2f(U('res'), cv.width, cv.height); gl.uniform2f(U('mouse'), mouse.x, mouse.y);
          gl.uniform1f(U('t'), (performance.now() - t0) / 1000); gl.uniform1f(U('scroll'), scrollY * 0.25 * dpr); gl.uniform1f(U('dpr'), dpr);
          gl.uniform3fv(U('rip'), rips); gl.drawArrays(gl.TRIANGLES, 0, 3);
        };
        // Frames are requested only while something changes (scroll, pointer, ripple), so an idle page costs nothing.
        let raf = 0;
        const loop = () => {
          raf = 0;
          const rippling = (performance.now() - t0) / 1000 - lastRip < 3.2;
          if (dirty || scrollY !== lastY || rippling) { draw(); dirty = false; lastY = scrollY; raf = requestAnimationFrame(loop); }
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
        if (reduced) { draw(); addEventListener('resize', draw); }
        else { for (const t of ['scroll', 'pointermove', 'pointerdown', 'resize']) addEventListener(t, kick, { passive: true }); loop(); }
      }

      const ph = document.querySelector<HTMLElement>('.phone');
      if (ph && matchMedia('(hover: hover)').matches) {
        ph.addEventListener('pointermove', (e) => {
          const r = ph.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
          ph.style.transform = `perspective(900px) rotateY(${x * 14}deg) rotateX(${-y * 10}deg)`;
        });
        ph.addEventListener('pointerleave', () => (ph.style.transform = ''));
      }

      const rvEls = document.querySelectorAll<HTMLElement>('main > section > .lab, main h1, main h2, main .lead, .card, .app-txt > :not(.lab), .live-txt > :not(.lab), .phone, .chart, .toggles, .plot, .cta, .bub, .src ol, .adv-c, .pc, .mails, .chatwin, .cform, .note-s');
      const rio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rio.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      rvEls.forEach((el) => { if (el.classList.contains('u-split')) return; el.classList.add('rv'); const sib = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0; el.style.setProperty('--dl', Math.min(sib, 5) * 0.07 + 's'); rio.observe(el); });
    </script>
  </body>
</html>
