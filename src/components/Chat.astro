---
// uid: serve solo se la stessa bolla compare due volte nella pagina (l'id del clipPath deve restare unico)
interface Props { kind: 'sent' | 'read' | 'online' | 'us' | 'client'; uid?: string }
const { kind, uid = '' } = Astro.props;
const lensId = `chatLens${uid}`;
const label = kind === 'sent' ? 'Consegnato' : kind === 'read' ? 'Visualizzato' : '';
const typing = kind === 'us' || kind === 'client';
const online = kind === 'online';
---
<div class={`bub rv ${kind}`} role="img" aria-label={online ? 'Punto Due Studio è online' : typing ? (kind === 'us' ? 'Punto Due Studio sta scrivendo' : 'Il cliente sta scrivendo') : `Messaggio ${label.toLowerCase()}`}>
  {(kind === 'us' || online) && (
    <svg class="av lente" viewBox="0 0 100 100" aria-hidden="true">
      <defs><clipPath id={lensId}><circle cx="37" cy="50" r="27" /></clipPath></defs>
      <circle cx="37" cy="50" r="27" fill="#fff" /><circle cx="63" cy="50" r="27" fill="#FFE000" /><circle cx="63" cy="50" r="27" fill="#0034D6" clip-path={`url(#${lensId})`} />
    </svg>
  )}
  {kind === 'client' && (
    <svg class="av cl" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#FFE000" /><circle cx="20" cy="15" r="6.5" fill="#0034D6" /><path d="M7 34c1.5-7 6.5-10 13-10s11.5 3 13 10a20 20 0 0 1-26 0z" fill="#0034D6" /></svg>
  )}
  <div class="cloud">
    {online ? (
      <><span class="live" aria-hidden="true"></span><span class="cap">Online</span></>
    ) : typing ? (
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    ) : (
      <>
        <svg class="ticks" viewBox="0 0 34 18" aria-hidden="true"><path class="t1" d="M2 9.5l4.5 4.5L16 3" /><path class="t2" d="M12 13.5l1.2 1.2L24.5 3" /></svg>
        <span class="cap">{label}</span>
      </>
    )}
  </div>
</div>

<style>
  .bub { display: inline-flex; align-items: flex-end; gap: 10px; }
  .av { flex: none; width: 46px; height: 46px; display: block; }
  .lente { padding: 6px; border-radius: 50%; background: #0a0f24; }
  .av.cl { width: 40px; height: 40px; }
  .cloud { display: inline-flex; align-items: center; gap: 14px; padding: 18px 22px 16px 24px; background: #fff; color: #0a0f24; border-radius: 26px 26px 26px 6px; box-shadow: 0 18px 50px rgba(0, 0, 0, .25); }
  .us .cloud, .client .cloud, .online .cloud { padding: 20px 24px; }
  .live { width: 12px; height: 12px; border-radius: 50%; background: #1fbf5b; animation: live 1.6s ease-out infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(31,191,91,.55); } 100% { box-shadow: 0 0 0 12px rgba(31,191,91,0); } }
  .ticks { width: clamp(64px, 12vw, 104px); height: auto; fill: none; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .ticks path { stroke: #aab3cc; stroke-dasharray: 30; stroke-dashoffset: 30; transition: stroke .4s .9s, stroke-dashoffset .5s ease-out; }
  .ticks .t2 { transition-delay: 1.1s, .35s; }
  .sent.in .ticks path, .read.in .ticks path { stroke-dashoffset: 0; }
  .read.in .ticks path { stroke: #0034d6; }
  .cap { font: 500 12px/1 ui-monospace, 'SF Mono', Consolas, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; color: #5a6178; }
  .dots { display: inline-flex; gap: 7px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #aab3cc; animation: dot 1.2s ease-in-out infinite; }
  .dots i:nth-child(2) { animation-delay: .18s; } .dots i:nth-child(3) { animation-delay: .36s; }
  @keyframes dot { 0%, 60%, 100% { transform: translateY(0); background: #aab3cc; } 30% { transform: translateY(-6px); background: #0034d6; } }
  @media (prefers-reduced-motion: reduce) { .dots i, .live { animation: none; } .ticks path { transition: none; stroke-dashoffset: 0; } }
</style>
