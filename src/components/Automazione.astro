---
// Sezione /automazione di /social: un OS agentico. Un agente principale coordina quattro agenti in una catena
// (post, messaggi, prenotazioni, report). La scena è un loop video di 5 secondi (/agent/os-loop.mp4), generato con Higgsfield
// dalla scena master (/agent/os-0): primo e ultimo fotogramma coincidono. Parte solo quando è a schermo; con animazioni ridotte resta la locandina.
// Senza JavaScript resta il primo passo; con animazioni ridotte la catena non avanza da sola.
const steps = [
  { t: 'Post programmati', a: 'Agente post', d: 'Il piano del mese è caricato: i post escono da soli, all\'ora giusta.', bot: 'Pubblico il reel di oggi alle 19:30.' },
  { t: 'Risposte ai messaggi', a: 'Agente messaggi', d: 'Chi scrive «siete aperti?» riceve subito orari e link per prenotare.', bot: 'Rispondo: aperti fino alle 23, ecco il link per prenotare.' },
  { t: 'WhatsApp e prenotazioni', a: 'Agente prenotazioni', d: 'La richiesta arriva su WhatsApp, con conferma e promemoria automatici.', bot: 'Tavolo per 4 confermato. Promemoria domani alle 18.' },
  { t: 'Report mensile', a: 'Agente report', d: 'A fine mese ricevi i numeri che contano, senza doverli chiedere.', bot: 'Report inviato: post, messaggi e prenotazioni del mese.' },
];
// dove sta ogni postazione nell'immagine (percentuali di larghezza e altezza) e dove sta il bot: il "pacchetto" parte dal bot e arriva lì
const spots = [[33.5, 30.5], [65.9, 32.2], [31.9, 55.3], [68.1, 55.3]];
const botAt = [47.5, 42.5];
const K = 74.69 / 75; // il disegno SVG è 100 x 74,69 come le immagini (1280 x 956)
---
<section class="auto" id="automazione" data-auto>
  <span class="lab">/automazione</span>
  <h2>Un OS agentico per il tuo profilo.</h2>
  <p class="lead">Lo impostiamo noi: un agente principale coordina quattro agenti in una sola catena, dal post alla prenotazione, fino al report.</p>

  <div class="os">
    <figure class="os-win" id="osWin">
      <div class="os-bar" aria-hidden="true"><i></i><i></i><i></i><span>agentos.demo</span></div>
      <div class="os-view">
        <div class="os-layers" id="osLayers">
          <video class="os-vid" id="osVid" src="/agent/os-loop.mp4" poster="/agent/os-0-1280.webp" width="960" height="720" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
          <svg class="os-fx" viewBox="0 0 100 74.69" preserveAspectRatio="none" aria-hidden="true">
            <circle id="osPing" r="1" cx={spots[0][0]} cy={spots[0][1] * K} />
            <circle id="osDot" r="1.15" cx={botAt[0]} cy={botAt[1] * K} />
          </svg>
        </div>
        <figcaption class="os-cap">
          <p class="os-h" id="osH1" aria-hidden="true"></p>
          <p class="os-h" id="osH2" aria-hidden="true"></p>
          <p class="os-now"><span class="os-who" id="osWho">{steps[0].a}</span><span id="osLine" aria-hidden="true">{steps[0].bot}</span><i class="os-caret" aria-hidden="true"></i></p>
          <span class="sr" id="botCap" aria-live="polite">{steps[0].bot}</span>
        </figcaption>
      </div>
    </figure>

    <div class="os-side">
      <div class="os-main">
        <svg class="os-lens" viewBox="0 0 100 100" aria-hidden="true">
          <defs><clipPath id="osLens"><circle cx="37" cy="50" r="27" /></clipPath></defs>
          <circle cx="37" cy="50" r="27" fill="#fff" /><circle cx="63" cy="50" r="27" fill="#FFE000" /><circle cx="63" cy="50" r="27" fill="#0034D6" clip-path="url(#osLens)" />
        </svg>
        <span class="os-main-t"><b>Agente principale</b><small>Assegna il lavoro a ogni agente.</small></span>
        <i class="os-live" aria-hidden="true"></i>
      </div>
      <ol class="steps" id="aSteps">
        {steps.map((s, i) => (
          <li class="stp" data-state={i === 0 ? 'on' : 'wait'}>
            <button type="button" class="step" aria-pressed={i === 0 ? 'true' : 'false'} data-bot={s.bot} data-a={s.a}>
              <span class="n">0{i + 1}</span>
              <span class="st"><em>{s.a}</em><b>{s.t}</b><small>{s.d}</small></span>
              <span class="tag" aria-hidden="true"><span class="tag-on">In corso</span><svg class="tag-ok" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
              <i class="bar" aria-hidden="true"></i>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="cta">
    <a class="btn btn-l" href="/info/">Scrivici <span class="arr">→</span></a>
    <a class="btn btn-l white" href="/agenti-ai/">Scopri gli agenti <span class="arr">→</span></a>
  </div>
  <p class="note">Simulazione illustrativa: mostra come si collegano le automazioni. Messaggi e orari sono d'esempio.</p>
</section>

<style>
  .auto { border-top: 1px solid rgba(255,255,255,.25); }
  .os { display: grid; gap: 28px; margin-top: 40px; align-items: start; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* la finestra dell'OS: i render sfumano l'uno nell'altro, il pacchetto giallo va dal bot alla postazione */
  .os-win { order: -1; margin: 0; border-radius: 24px; border: 1px solid rgba(255,255,255,.3); background: #0029b8; overflow: hidden; box-shadow: 0 30px 80px rgba(0,10,70,.35); }
  .os-bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; border-bottom: 1px solid rgba(255,255,255,.3); background: rgba(0,24,120,.55); }
  .os-bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--yellow); }
  .os-bar i:nth-child(2) { background: #fff; } .os-bar i:nth-child(3) { background: transparent; box-shadow: inset 0 0 0 1.5px #fff; }
  .os-bar span { margin-left: 10px; font: 500 11px/1 var(--mono); letter-spacing: .1em; color: rgba(255,255,255,.75); }
  .os-view { position: relative; aspect-ratio: 1280 / 956; overflow: hidden; background: #0a33c8; }
  .os-layers { position: absolute; inset: 0; transform: scale(1.04); will-change: transform; }
  .os-vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; background: #0a33c8; }
  .os-fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  #osDot { opacity: 0; fill: var(--yellow); filter: drop-shadow(0 0 .9px #fff) drop-shadow(0 0 2.4px var(--yellow)); }
  #osPing { fill: none; stroke: var(--yellow); stroke-width: .35; opacity: 0; }
  .os-cap { position: absolute; left: 12px; right: 12px; bottom: 12px; display: grid; gap: 4px; padding: 12px 16px; border-radius: 14px; background: rgba(10,15,36,.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: .92rem; line-height: 1.4; }
  .os-cap p { margin: 0; }
  .os-h { color: rgba(255,255,255,.45); font-size: .8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .os-h:empty { display: none; }
  .os-now { display: flex; gap: 10px; align-items: baseline; }
  .os-who { flex: none; font: 700 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--yellow); }
  .os-caret { flex: none; align-self: center; width: 7px; height: 14px; margin-left: -4px; background: var(--yellow); animation: caret 1s steps(2) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  /* l'agente principale e la catena: i quattro passi sono collegati da una linea che diventa gialla man mano che il lavoro passa di mano */
  .os-main { display: flex; align-items: center; gap: 14px; padding: 14px 18px; margin-bottom: 14px; border: 1px solid var(--yellow); border-radius: 16px; background: rgba(255,224,0,.08); }
  .os-lens { flex: none; width: 40px; height: 40px; padding: 6px; border-radius: 50%; background: #0a0f24; }
  .os-main-t { display: grid; gap: 2px; } .os-main-t b { font-size: 1.05rem; letter-spacing: -.01em; } .os-main-t small { font-size: .88rem; color: rgba(255,255,255,.78); }
  .os-live { margin-left: auto; flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--yellow); animation: live 1.8s ease-out infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(255,224,0,.55); } 100% { box-shadow: 0 0 0 12px rgba(255,224,0,0); } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; align-content: start; }
  .stp { position: relative; }
  .stp:not(:last-child)::after { content: ''; position: absolute; left: 35px; top: 60px; bottom: -14px; width: 2px; border-radius: 2px; background: rgba(255,255,255,.2); transition: background .5s; }
  .stp[data-state="done"]:not(:last-child)::after { background: var(--yellow); }
  .step { position: relative; overflow: hidden; display: flex; gap: 14px; align-items: flex-start; width: 100%; min-height: 44px; padding: 16px 18px; text-align: left; font: inherit; color: #fff; background: rgba(0,52,214,.6); border: 1px solid rgba(255,255,255,.3); border-radius: 16px; cursor: pointer; transition: border-color .25s, background .25s, transform .25s var(--ease); }
  .step:hover { border-color: rgba(255,255,255,.7); }
  .step:active { scale: .985; }
  .step[aria-pressed="true"] { border-color: var(--yellow); background: rgba(255,224,0,.1); }
  .n { flex: none; position: relative; z-index: 1; display: grid; place-items: center; width: 36px; height: 36px; margin: -4px 0 -4px -4px; border-radius: 50%; background: #0a33c8; border: 1px solid rgba(255,255,255,.35); font: 700 12px/1 var(--mono); letter-spacing: .06em; color: rgba(255,255,255,.8); transition: background .3s, color .3s, border-color .3s; }
  .stp[data-state="on"] .n { background: var(--yellow); border-color: var(--yellow); color: var(--blue); }
  .stp[data-state="done"] .n { border-color: var(--yellow); color: var(--yellow); }
  .st { display: grid; gap: 4px; min-width: 0; }
  .st em { font: 700 11px/1.2 var(--mono); font-style: normal; letter-spacing: .12em; text-transform: uppercase; color: var(--yellow); }
  .st b { font-size: 1.05rem; letter-spacing: -.01em; } .st small { font-size: .9rem; line-height: 1.4; color: rgba(255,255,255,.78); }
  .tag { margin-left: auto; flex: none; display: grid; place-items: center; min-width: 20px; height: 20px; }
  .tag-on { display: none; font: 700 10px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; background: var(--yellow); color: var(--blue); }
  .tag-ok { display: none; width: 20px; height: 20px; fill: none; stroke: var(--yellow); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .stp[data-state="on"] .tag-on { display: block; }
  .stp[data-state="done"] .tag-ok { display: block; }
  .bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--yellow); }
  .auto[data-auto] .step[aria-pressed="true"] .bar { animation: abar 4s linear both; }
  @keyframes abar { to { width: 100%; } }

  @media (min-width: 1024px) { .os { grid-template-columns: minmax(320px, .85fr) 1.15fr; gap: 36px; } .os-win { order: 0; position: sticky; top: 110px; } .os-side { order: -1; } }
  @media (max-width: 700px) { .os-cap { left: 8px; right: 8px; bottom: 8px; padding: 10px 12px; font-size: .86rem; } .os-h { display: none; } }
  @media (prefers-reduced-motion: reduce) { .step, .stp::after, .n { transition: none; } .os-caret, .os-live { animation: none; } .os-layers { transform: none; } }
</style>

<script>
  import { animate } from 'animejs';

  const sec = document.getElementById('automazione')!;
  const win = document.getElementById('osWin')!;
  const layers = document.getElementById('osLayers')!;
  const vid = document.getElementById('osVid') as HTMLVideoElement;
  const dot = document.getElementById('osDot') as unknown as SVGCircleElement;
  const ping = document.getElementById('osPing') as unknown as SVGCircleElement;
  const cap = document.getElementById('botCap')!, line = document.getElementById('osLine')!, who = document.getElementById('osWho')!;
  const h1 = document.getElementById('osH1')!, h2 = document.getElementById('osH2')!;
  const btns = [...document.querySelectorAll<HTMLButtonElement>('#aSteps .step')];
  const items = btns.map((b) => b.closest('li')!);
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  // postazioni e posizione del bot, in unità del viewBox del disegno (100 x 74.69)
  const K = 74.69 / 75;
  const spots = [[33.5, 30.5], [65.9, 32.2], [31.9, 55.3], [68.1, 55.3]].map(([x, y]) => [x, y * K]);
  const bot = [47.5, 42.5 * K];
  let cur = 0, auto = !rm, vis = false;
  const hist: string[] = [];
  let typing: { pause: () => unknown } | null = null;

  const typeLine = (text: string) => {
    typing?.pause();
    if (rm) { line.textContent = text; return; }
    const o = { n: 0 };
    typing = animate(o, { n: text.length, duration: Math.min(1200, 26 * text.length + 200), ease: 'linear', onUpdate: () => { line.textContent = text.slice(0, Math.round(o.n)); } });
  };

  // il pacchetto giallo parte dal bot, arriva alla postazione e fa un'onda
  const dispatch = (i: number) => {
    if (rm) return;
    const [tx, ty] = spots[i];
    animate(dot, { cx: [bot[0], tx], cy: [bot[1], ty], duration: 800, ease: 'inOut(3)' });
    animate(dot, { opacity: [0, 1, 1, 0], duration: 800, ease: 'linear' });
    ping.setAttribute('cx', String(tx)); ping.setAttribute('cy', String(ty));
    animate(ping, { r: [1, 7], opacity: [0.9, 0], duration: 900, delay: 700, ease: 'out(2)' });
  };

  const setStep = (i: number) => {
    if (i === cur && cap.textContent === btns[i].dataset.bot) return;
    const prev = line.textContent || '';
    if (i !== cur) { hist.push(`${who.textContent} · ${prev}`); while (hist.length > 2) hist.shift(); }
    h1.textContent = hist.length > 1 ? hist[hist.length - 2] : ''; h2.textContent = hist.length ? hist[hist.length - 1] : '';
    cur = i;
    btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
    items.forEach((li, k) => { li.dataset.state = k === i ? 'on' : k < i ? 'done' : 'wait'; });
    who.textContent = btns[i].dataset.a!;
    cap.textContent = btns[i].dataset.bot!;
    typeLine(btns[i].dataset.bot!);
    dispatch(i);
  };
  btns.forEach((b, i) => b.addEventListener('click', () => { auto = false; sec.removeAttribute('data-auto'); setStep(i); }));
  if (!auto) sec.removeAttribute('data-auto');
  // la catena avanza da sola solo mentre è a schermo; un clic dell'utente la ferma
  setInterval(() => { if (auto && vis && !document.hidden) setStep((cur + 1) % btns.length); }, 4000);
  new IntersectionObserver(([e]) => { vis = e.isIntersecting; if (!rm) { if (vis) vid.play().catch(() => {}); else vid.pause(); } }, { threshold: 0.35 }).observe(win);

  // la scena segue il puntatore di pochi pixel (molla), solo con il mouse
  if (fine && !rm) {
    win.addEventListener('pointermove', (e) => {
      const r = win.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      animate(layers, { x: -x * 18, y: -y * 12, duration: 600, ease: 'out(3)' });
    });
    win.addEventListener('pointerleave', () => animate(layers, { x: 0, y: 0, duration: 900, ease: 'out(3)' }));
  }
</script>
